<?php

/**
 * @file
 * Fonctions de preprocess et suggestions de thèmes pour Gouvernoratkin.
 */

use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function gouvernoratkin_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Suggérer page--services-aux-citoyens si l'alias d'URL commence par /services-aux-citoyens
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  if ($alias == '/services-aux-citoyens' || strpos($alias, '/services-aux-citoyens/') === 0) {
    $suggestions[] = 'page__services_aux_citoyens';
  }

  // Pages du compte (connexion, mot de passe oublié) : gabarit
  // page--compte.html.twig, aligné sur les pages institutionnelles.
  if (in_array(\Drupal::routeMatch()->getRouteName(), ['user.login', 'user.pass'], TRUE)) {
    $suggestions[] = 'page__compte';
  }

  // Suggérer page--video pour la page d'un contenu « Vidéo » (pas pour ses
  // pages d'édition ou de révision, qui gardent le gabarit général).
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');
  if ($route_match->getRouteName() === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'video') {
    $suggestions[] = 'page__video';
  }
}

/**
 * Étiquettes de cache de l'arbre des rubriques des services aux citoyens.
 *
 * Sans elles, la barre latérale restait figée dans le cache (pages des
 * visiteurs anonymes comprises) après l'ajout, la suppression ou la
 * dépublication d'une rubrique.
 * - taxonomy_term_list : tout ajout, modification ou suppression de terme ;
 * - config:system.menu.main : activation ou désactivation d'un lien du menu
 *   principal.
 */
function _gouvernoratkin_services_tree_cache_tags() {
  // node_list : une rubrique vide réapparaît dès qu'une démarche y est publiée.
  return ['taxonomy_term_list', 'config:system.menu.main', 'node_list'];
}

/**
 * Rubriques des services aux citoyens sans aucune démarche publiée.
 *
 * Une rubrique compte les démarches de toutes ses sous-rubriques. Les
 * rubriques vides affichaient « Aucune démarche trouvée » (Famille, Habitat,
 * Loisirs…) : elles sont masquées de la barre latérale et du menu jusqu'à
 * la publication d'une première démarche.
 *
 * @return array
 *   Identifiants des rubriques vides, en clés.
 */
function _gouvernoratkin_services_tids_vides() {
  $vides = &drupal_static(__FUNCTION__);
  if (isset($vides)) {
    return $vides;
  }

  $base = \Drupal::database();
  $requete = $base->select('node__field_service_au_citoyen', 'r');
  $requete->join('node_field_data', 'n', 'n.nid = r.entity_id AND n.default_langcode = 1');
  $requete->condition('n.status', 1);
  $requete->condition('r.deleted', 0);
  $requete->addField('r', 'field_service_au_citoyen_target_id', 'tid');
  $requete->addExpression('COUNT(DISTINCT r.entity_id)', 'nombre');
  $requete->groupBy('r.field_service_au_citoyen_target_id');
  $directs = $requete->execute()->fetchAllKeyed();

  $termes = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('service_au_citoyen', 0, NULL, FALSE);
  $total = [];
  foreach ($termes as $terme) {
    $total[(int) $terme->tid] = 0;
  }
  // Chaque démarche compte pour sa rubrique et pour tous ses ascendants.
  $parents = [];
  foreach ($termes as $terme) {
    $parents[(int) $terme->tid] = array_filter(array_map('intval', $terme->parents));
  }
  foreach ($directs as $tid => $nombre) {
    $pile = [(int) $tid];
    $vus = [];
    while ($pile) {
      $courant = array_pop($pile);
      if (isset($vus[$courant]) || !isset($total[$courant])) {
        continue;
      }
      $vus[$courant] = TRUE;
      $total[$courant] += (int) $nombre;
      foreach ($parents[$courant] ?? [] as $parent) {
        $pile[] = $parent;
      }
    }
  }

  $vides = array_fill_keys(array_keys(array_filter($total, fn($n) => $n === 0)), TRUE);
  return $vides;
}

/**
 * Identifiants des rubriques dont le lien est désactivé dans le menu principal.
 *
 * Le menu principal est construit par Taxonomy Menu : décocher « Activé » sur
 * un lien le masque du menu. La barre latérale suit le même choix.
 */
function _gouvernoratkin_services_tids_desactives() {
  $tids = [];
  // Arbre complet du menu, liens désactivés compris (mis en cache par Drupal).
  $arbre = \Drupal::menuTree()->load('main', new \Drupal\Core\Menu\MenuTreeParameters());
  $parcourir = function (array $elements) use (&$parcourir, &$tids) {
    foreach ($elements as $element) {
      $lien = $element->link;
      $tid = $lien->getMetaData()['taxonomy_term_id'] ?? NULL;
      if ($tid && !$lien->isEnabled()) {
        $tids[(int) $tid] = TRUE;
      }
      if ($element->subtree) {
        $parcourir($element->subtree);
      }
    }
  };
  $parcourir($arbre);
  return $tids;
}

/**
 * Arbre des rubriques publiées du vocabulaire service_au_citoyen.
 *
 * Comme dans le menu principal, une rubrique est écartée si elle est
 * dépubliée ou si son lien de menu est désactivé ; ses sous-rubriques
 * disparaissent avec elle.
 */
function _gouvernoratkin_get_services_categories_tree() {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadTree('service_au_citoyen', 0, NULL, FALSE);
  $desactives = _gouvernoratkin_services_tids_desactives() + _gouvernoratkin_services_tids_vides();

  $tree = [];
  $terms_by_id = [];

  foreach ($terms as $term) {
    $tid = $term->tid;
    if ((isset($term->status) && !$term->status) || isset($desactives[(int) $tid])) {
      continue;
    }
    $terms_by_id[$tid] = [
      'tid' => $tid,
      'name' => $term->name,
      'children' => [],
      'parents' => [],
    ];
    
    foreach ($term->parents as $parent) {
      if ($parent != '0') {
        $terms_by_id[$tid]['parents'][] = (int) $parent;
      }
    }
  }
  
  foreach ($terms_by_id as $tid => &$term_data) {
    if (empty($term_data['parents'])) {
      $tree[$tid] = &$term_data;
    } else {
      foreach ($term_data['parents'] as $parent_id) {
        if (isset($terms_by_id[$parent_id])) {
          $terms_by_id[$parent_id]['children'][$tid] = &$term_data;
        }
      }
    }
  }
  
  return $tree;
}

/**
 * Implements hook_preprocess_page().
 */
function gouvernoratkin_preprocess_page(&$variables) {
  // Titre et chapô des pages du compte (page--compte.html.twig).
  $compte = [
    'user.login' => ['Connexion', "Espace réservé aux équipes du Gouvernorat qui publient et mettent à jour le site."],
    'user.pass' => ['Mot de passe oublié', "Indiquez l'adresse de courriel ou le nom d'utilisateur de votre compte : un lien pour choisir un nouveau mot de passe vous sera envoyé."],
  ];
  $route_compte = \Drupal::routeMatch()->getRouteName();
  if (isset($compte[$route_compte])) {
    [$variables['compte_titre'], $variables['compte_accroche']] = $compte[$route_compte];
    $variables['compte_route'] = $route_compte;
  }

  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  
  // La redirection d'une rubrique des services vers /services-aux-citoyens/N
  // se fait désormais en 301 dans le module gouvernorat_seo
  // (RedirectionSubscriber), et non plus ici en 302 avec exit().

  if ($alias == '/services-aux-citoyens' || strpos($alias, '/services-aux-citoyens/') === 0) {
    $variables['services_categories_tree'] = _gouvernoratkin_get_services_categories_tree();
    foreach (_gouvernoratkin_services_tree_cache_tags() as $tag) {
      $variables['#cache']['tags'][] = $tag;
    }

    $active_tid = null;
    $parts = explode('/', ltrim($alias, '/'));
    if (isset($parts[1]) && is_numeric($parts[1])) {
      $active_tid = (int) $parts[1];
    }
    $variables['active_category_tid'] = $active_tid;

    // Nom de la rubrique choisie, pour le titre de la liste.
    if ($active_tid && ($term = Term::load($active_tid)) && $term->bundle() === 'service_au_citoyen') {
      $variables['active_category_name'] = $term->label();

      // Présentation du secteur (description du terme), affichée en tête de
      // la liste : base légale commune, arrêté fixant les taux…
      if (trim((string) $term->getDescription()) !== '') {
        $variables['active_category_description'] = [
          '#type' => 'processed_text',
          '#text' => $term->getDescription(),
          '#format' => $term->getFormat(),
        ];
      }
      $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
    }
  }
}

/**
 * Renvoie la rubrique d'une fiche « Service au citoyen ».
 *
 * Le champ de rubrique de ce type de contenu est field_service_au_citoyen.
 * Le thème lisait field_categorie, qui n'existe pas sur ces fiches : le badge,
 * le fil d'Ariane et la rubrique active de la barre latérale restaient vides.
 * field_categorie est gardé en repli au cas où il serait ajouté plus tard.
 */
function _gouvernoratkin_service_term($node) {
  foreach (['field_service_au_citoyen', 'field_categorie'] as $field) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty() && ($term = $node->get($field)->entity)) {
      return $term;
    }
  }
  return NULL;
}

/**
 * Résumé d'une fiche pour la liste des services.
 *
 * Beaucoup de fiches commencent par reprendre leur titre en tête du texte :
 * découpé tel quel, le résumé répétait le titre juste sous celui-ci. Le titre
 * est donc retiré du début du texte avant la découpe.
 */
function _gouvernoratkin_service_resume($node, $longueur = 220) {
  if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
    return '';
  }
  $body = $node->get('body')->first();
  $texte = $body->summary ?: $body->value;
  $texte = html_entity_decode(strip_tags(str_replace('<', ' <', $texte)), ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $texte = trim(preg_replace('/\s+/u', ' ', $texte));

  $titre = trim(preg_replace('/\s+/u', ' ', $node->label()));
  if ($titre !== '' && mb_stripos($texte, $titre) === 0) {
    $texte = ltrim(mb_substr($texte, mb_strlen($titre)), " \t.:;,-–—");
  }

  return \Drupal\Component\Utility\Unicode::truncate($texte, $longueur, TRUE, TRUE);
}

/**
 * Implements hook_preprocess_node().
 */
function gouvernoratkin_preprocess_node(&$variables) {
  $node = $variables['node'] ?? NULL;
  if ($node && is_object($node) && method_exists($node, 'bundle') && $node->bundle() === 'service_au_citoyen') {
    $term = _gouvernoratkin_service_term($node);
    $variables['active_category_tid'] = $term ? (int) $term->id() : NULL;
    $variables['service_category_name'] = $term ? $term->label() : NULL;

    if ($variables['view_mode'] === 'teaser') {
      $variables['service_resume'] = _gouvernoratkin_service_resume($node);
    }
    else {
      $variables['services_categories_tree'] = _gouvernoratkin_get_services_categories_tree();
      foreach (_gouvernoratkin_services_tree_cache_tags() as $tag) {
        $variables['#cache']['tags'][] = $tag;
      }
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Indications de chargement anticipé (diagnostic, lot 2) :
 * - accueil : préchargement de la photo du bandeau, la plus grande image
 *   visible à l'ouverture, dans sa version écran large ou téléphone ;
 * - accueil et page /videos : préconnexion au serveur des vignettes YouTube
 *   (i.ytimg.com), pour gagner l'ouverture de connexion avant leur affichage.
 */
function gouvernoratkin_page_attachments_alter(array &$attachments) {
  $accueil = \Drupal::service('path.matcher')->isFrontPage();
  $chemin = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($chemin);
  $images = '/' . \Drupal::service('extension.list.theme')->getPath('gouvernoratkin') . '/assets/images/';

  if ($accueil) {
    $prechargements = [
      'accueil_hero_mobile' => ['accueil-hero-mobile.webp', '(max-width: 767.98px)'],
      'accueil_hero' => ['accueil-hero.webp', '(min-width: 768px)'],
    ];
    foreach ($prechargements as $cle => [$fichier, $media]) {
      $attachments['#attached']['html_head'][] = [[
        '#tag' => 'link',
        '#attributes' => [
          'rel' => 'preload',
          'as' => 'image',
          'type' => 'image/webp',
          'href' => $images . $fichier,
          'media' => $media,
          'fetchpriority' => 'high',
        ],
      ], 'gouvernoratkin_' . $cle];
    }
  }

  if ($accueil || $alias === '/videos') {
    $attachments['#attached']['html_head'][] = [[
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'preconnect',
        // Pas d'attribut crossorigin : les vignettes sont de simples <img>,
        // chargées sans CORS ; une préconnexion CORS ne leur servirait pas.
        'href' => 'https://i.ytimg.com',
      ],
    ], 'gouvernoratkin_preconnect_ytimg'];
  }

  // Icônes du site (constat R9) : le favicon.ico du thème est repris par
  // Drupal ; s'y ajoutent une version PNG nette et l'icône des écrans
  // d'accueil (iPhone, Android), tirées du blason de la ville.
  $icones = $images . 'icones/';
  $liens = [
    'icone_png' => ['rel' => 'icon', 'type' => 'image/png', 'sizes' => '32x32', 'href' => $icones . 'favicon-32.png'],
    'icone_apple' => ['rel' => 'apple-touch-icon', 'sizes' => '180x180', 'href' => $icones . 'apple-touch-icon.png'],
    'icone_192' => ['rel' => 'icon', 'type' => 'image/png', 'sizes' => '192x192', 'href' => $icones . 'icon-192.png'],
  ];
  foreach ($liens as $cle => $attributs) {
    $attachments['#attached']['html_head'][] = [['#tag' => 'link', '#attributes' => $attributs], 'gouvernoratkin_' . $cle];
  }

  // Ces indications dépendent de l'adresse : le cache doit en tenir compte.
  $attachments['#cache']['contexts'][] = 'url.path';
}

/**
 * Nombre maximal de sous-entrées affichées dans un sous-menu de 2e niveau.
 *
 * Constat U9 du diagnostic : « Droits, Taxes et Redevances » déroulait 27
 * secteurs, une liste qui dépassait la hauteur de l'écran. Au-delà de ce
 * seuil, la rubrique devient un simple lien vers sa page, dont la barre
 * latérale présente tous les secteurs.
 */
const GOUVERNORATKIN_MENU_MAX_ENFANTS = 12;

/**
 * Implements hook_preprocess_HOOK() for menu--main.html.twig.
 */
function gouvernoratkin_preprocess_menu__main(array &$variables) {
  $variables['items'] = _gouvernoratkin_menu_principal_ajuster($variables['items'] ?? [], 0);
  // Les rubriques vides sont masquées : le menu suit les publications.
  $variables['#cache']['tags'][] = 'node_list';
  $variables['#cache']['tags'][] = 'taxonomy_term_list';
}

/**
 * Ajuste les liens du menu principal, niveau par niveau.
 *
 * - Un lien vers une rubrique des services aux citoyens (lien de terme créé
 *   par Taxonomy Menu) pointe directement vers /services-aux-citoyens/N,
 *   sans passer par la redirection de /taxonomy/term/N.
 * - Sous le premier niveau, un sous-menu trop long est retiré.
 */
function _gouvernoratkin_menu_principal_ajuster(array $items, int $niveau) {
  foreach ($items as $cle => &$item) {
    $url = $item['url'] ?? NULL;
    if ($url instanceof \Drupal\Core\Url && $url->isRouted() && $url->getRouteName() === 'entity.taxonomy_term.canonical') {
      $tid = $url->getRouteParameters()['taxonomy_term'] ?? NULL;
      $terme = $tid ? Term::load($tid) : NULL;
      if ($terme && $terme->bundle() === 'service_au_citoyen' && isset(_gouvernoratkin_services_tids_vides()[(int) $terme->id()])) {
        unset($items[$cle]);
        continue;
      }
      if ($terme && $terme->bundle() === 'service_au_citoyen') {
        // La rubrique racine mène à la page générale des services.
        $racine = (int) $terme->get('parent')->target_id === 0;
        $item['url'] = \Drupal\Core\Url::fromUserInput('/services-aux-citoyens' . ($racine ? '' : '/' . $terme->id()), $url->getOptions());
      }
    }

    if (!empty($item['below'])) {
      // Les sous-entrées vides sont retirées avant de compter.
      $item['below'] = _gouvernoratkin_menu_principal_ajuster($item['below'], $niveau + 1);
      if ($niveau >= 1 && count($item['below']) > GOUVERNORATKIN_MENU_MAX_ENFANTS) {
        $item['below'] = [];
      }
      if (empty($item['below'])) {
        $item['is_expanded'] = FALSE;
      }
    }
  }
  unset($item);
  return $items;
}

/**
 * Implements hook_preprocess_HOOK() for views-view-fields--singlepost.
 *
 * Page d'un article. Le balisage était écrit dans la configuration de la vue
 * (champ « Texte personnalisé »), avec deux défauts : le titre était un
 * <h3> (aucun <h1> sur la page) et tout le texte de l'article était enfermé
 * dans un <p>, que le navigateur cassait en paragraphes vides. Le gabarit
 * views-view-fields--singlepost.html.twig reçoit ici des variables simples :
 * article.titre, image, categorie { nom, url }, date, date_iso, lecture
 * (minutes), corps (texte filtré), tags [{ nom, url }], partage.
 */
function gouvernoratkin_preprocess_views_view_fields__singlepost(array &$variables) {
  $vue = $variables['view'];
  $ligne = $variables['row'];
  $node = $ligne->_entity ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }

  $champ_vue = function (string $nom) use ($vue, $ligne) {
    $rendu = $vue->style_plugin->getField($ligne->index, $nom);
    return ($rendu !== NULL && trim(strip_tags((string) $rendu, '<img><a><ul><li><span><i>')) !== '') ? $rendu : NULL;
  };

  $corps = NULL;
  $mots = 0;
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $item = $node->get('body')->first();
    $corps = ['#type' => 'processed_text', '#text' => $item->value, '#format' => $item->format];
    $mots = str_word_count(strip_tags($item->value), 0, 'àâäéèêëîïôöùûüçœÀÂÄÉÈÊËÎÏÔÖÙÛÜÇŒ’\'-');
  }

  $categorie = NULL;
  if ($node->hasField('field_categorie') && ($terme = $node->get('field_categorie')->entity)) {
    $categorie = ['nom' => $terme->label(), 'url' => $terme->toUrl()->toString()];
  }
  $tags = [];
  if ($node->hasField('field_tags')) {
    foreach ($node->get('field_tags')->referencedEntities() as $terme) {
      $tags[] = ['nom' => $terme->label(), 'url' => $terme->toUrl()->toString()];
    }
  }

  $variables['article'] = [
    'titre' => $node->label(),
    'image' => $champ_vue('field_image_media'),
    'categorie' => $categorie,
    'date' => \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'j F Y'),
    'date_iso' => date('c', $node->getCreatedTime()),
    // Temps de lecture : 200 mots par minute, une minute au moins.
    'lecture' => max(1, (int) round($mots / 200)),
    'corps' => $corps,
    'tags' => $tags,
    'partage' => $champ_vue('addtoany_share'),
  ];
  $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], $node->getCacheTags());
}

/**
 * Page de résultats de la recherche : mots cherchés et nombre de résultats.
 */
function gouvernoratkin_preprocess_views_view__page_de_recherche(array &$variables): void {
  $view = $variables['view'];
  $variables['recherche'] = [
    'cles' => trim((string) \Drupal::request()->query->get('keys', '')),
    'total' => (int) ($view->total_rows ?? count($view->result)),
  ];
  $variables['#cache']['contexts'][] = 'url.query_args:keys';
}

/**
 * Un résultat de recherche : type, titre, extrait surligné, date, image.
 *
 * L'extrait vient du texte indexé de la page (paragraphes et sections
 * compris), avec les mots cherchés mis en évidence.
 */
function gouvernoratkin_preprocess_views_view_fields__page_de_recherche(array &$variables): void {
  $node = $variables['row']->_entity ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface) {
    return;
  }
  $types = [
    'article' => 'Actualité',
    'evenement' => 'Événement',
    'gallery' => 'Galerie photos',
    'video' => 'Vidéo',
    'service_au_citoyen' => 'Démarche',
    'membre' => 'Institutions',
    'page' => 'Page',
    'page_a_propos' => 'Page',
  ];
  $bundle = $node->bundle();
  $cles = trim((string) \Drupal::request()->query->get('keys', ''));
  $langue = $node->language()->getId();

  // Extrait : texte de la page tel qu'il est indexé (affichage « index de
  // recherche », sections comprises), avec accents et majuscules.
  $extrait = NULL;
  if ($cles !== '') {
    $element = \Drupal::entityTypeManager()->getViewBuilder('node')->view($node, 'search_index', $langue);
    $html = (string) \Drupal::service('renderer')->renderInIsolation($element);
    // Espace entre les blocs, pour que les mots ne se collent pas.
    $html = preg_replace('#<(/?(p|div|h[1-6]|li|td|th|br|section|article|figcaption)\b)#i', ' <$1', $html);
    $texte = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($html), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
    if ($texte !== '') {
      $extrait = search_excerpt($cles, $texte, $langue);
    }
  }

  // Image : illustration de l'article ou photo du membre.
  $image = NULL;
  $style = \Drupal\image\Entity\ImageStyle::load('carte_teaser');
  if ($node->hasField('field_image_media') && ($media = $node->get('field_image_media')->entity)) {
    $fid = $media->getSource()->getSourceFieldValue($media);
    $fichier = $fid ? \Drupal\file\Entity\File::load($fid) : NULL;
    if ($fichier && $style) {
      $image = $style->buildUrl($fichier->getFileUri());
    }
  }
  elseif ($node->hasField('field_membre_photo') && ($fichier = $node->get('field_membre_photo')->entity) && $style) {
    $image = $style->buildUrl($fichier->getFileUri());
  }

  // Précision sous le titre : catégorie d'un article, fonction d'un membre.
  $precision = NULL;
  if ($node->hasField('field_categorie') && ($terme = $node->get('field_categorie')->entity)) {
    $precision = $terme->label();
  }
  elseif ($node->hasField('field_membre_fonction') && !$node->get('field_membre_fonction')->isEmpty()) {
    $precision = $node->get('field_membre_fonction')->value;
  }

  $date = NULL;
  if (in_array($bundle, ['article', 'evenement', 'gallery', 'video'], TRUE)) {
    $date = [
      'texte' => \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'j F Y'),
      'iso' => date('Y-m-d', $node->getCreatedTime()),
    ];
  }

  // Numéro du résultat, qui continue d'une page à l'autre (11, 12… en page 2).
  $vue = $variables['view'];
  $par_page = (int) $vue->getItemsPerPage();
  $page = $vue->pager ? (int) $vue->pager->getCurrentPage() : 0;
  $numero = $page * $par_page + (int) ($variables['row']->index ?? 0) + 1;

  $variables['resultat'] = [
    'numero' => $numero,
    'type' => $types[$bundle] ?? 'Page',
    'type_classe' => \Drupal\Component\Utility\Html::getClass($bundle),
    'titre' => $node->label(),
    'url' => $node->toUrl()->toString(),
    'precision' => $precision,
    'extrait' => $extrait,
    'image' => $image,
    'date' => $date,
  ];
  $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], $node->getCacheTags());
}

/**
 * Formulaires de recherche : champ « search », texte indicatif, bouton.
 */
function gouvernoratkin_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'views_exposed_form' && ($form['#id'] ?? '') === 'views-exposed-form-page-de-recherche-page-1') {
    $form['#attributes']['class'][] = 'recherche-formulaire';
    $form['#attributes']['role'] = 'search';
    $form['keys']['#type'] = 'search';
    $form['keys']['#title_display'] = 'invisible';
    $form['keys']['#attributes']['placeholder'] = 'Une démarche, une actualité, un service…';
    $form['keys']['#attributes']['class'][] = 'recherche-champ';
    $form['keys']['#size'] = NULL;
    $form['actions']['submit']['#attributes']['class'][] = 'recherche-bouton';
  }
  if ($form_id === 'search_block_form') {
    $form['#attributes']['class'][] = 'recherche-formulaire';
    $form['#attributes']['class'][] = 'recherche-formulaire--compact';
    $form['keys']['#title_display'] = 'invisible';
    $form['keys']['#attributes']['placeholder'] = 'Rechercher sur le site';
    $form['keys']['#attributes']['class'][] = 'recherche-champ';
    $form['keys']['#size'] = NULL;
    $form['actions']['submit']['#value'] = 'Rechercher';
    $form['actions']['submit']['#attributes']['class'][] = 'recherche-bouton';
  }
}

/**
 * Fil d'Ariane de la page de recherche : « Accueil › Rechercher sur le site ».
 *
 * Sans cela, il passait par /search, intitulé « Search » en anglais.
 */
function gouvernoratkin_preprocess_breadcrumb(array &$variables): void {
  // La vue remplace la page de recherche de Drupal en gardant le nom de sa
  // route (search.view_node_search).
  if (!in_array(\Drupal::routeMatch()->getRouteName(), ['search.view_node_search', 'view.page_de_recherche.page_1'], TRUE)) {
    return;
  }
  $variables['breadcrumb'] = array_slice($variables['breadcrumb'] ?? [], 0, 1);
  $variables['breadcrumb'][] = ['text' => 'Rechercher sur le site', 'url' => NULL];
  $variables['#cache']['contexts'][] = 'route';
}
