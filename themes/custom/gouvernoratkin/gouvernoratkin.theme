<?php

/**
 * @file
 * Fonctions de preprocess et suggestions de thèmes pour Gouvernoratkin.
 */

use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function gouvernoratkin_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Suggérer page--services-aux-citoyens si l'alias d'URL commence par /services-aux-citoyens
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  if ($alias == '/services-aux-citoyens' || strpos($alias, '/services-aux-citoyens/') === 0) {
    $suggestions[] = 'page__services_aux_citoyens';
  }

  // Suggérer page--video pour la page d'un contenu « Vidéo » (pas pour ses
  // pages d'édition ou de révision, qui gardent le gabarit général).
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');
  if ($route_match->getRouteName() === 'entity.node.canonical' && $node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'video') {
    $suggestions[] = 'page__video';
  }
}

/**
 * Étiquettes de cache de l'arbre des rubriques des services aux citoyens.
 *
 * Sans elles, la barre latérale restait figée dans le cache (pages des
 * visiteurs anonymes comprises) après l'ajout, la suppression ou la
 * dépublication d'une rubrique.
 * - taxonomy_term_list : tout ajout, modification ou suppression de terme ;
 * - config:system.menu.main : activation ou désactivation d'un lien du menu
 *   principal.
 */
function _gouvernoratkin_services_tree_cache_tags() {
  return ['taxonomy_term_list', 'config:system.menu.main'];
}

/**
 * Identifiants des rubriques dont le lien est désactivé dans le menu principal.
 *
 * Le menu principal est construit par Taxonomy Menu : décocher « Activé » sur
 * un lien le masque du menu. La barre latérale suit le même choix.
 */
function _gouvernoratkin_services_tids_desactives() {
  $tids = [];
  // Arbre complet du menu, liens désactivés compris (mis en cache par Drupal).
  $arbre = \Drupal::menuTree()->load('main', new \Drupal\Core\Menu\MenuTreeParameters());
  $parcourir = function (array $elements) use (&$parcourir, &$tids) {
    foreach ($elements as $element) {
      $lien = $element->link;
      $tid = $lien->getMetaData()['taxonomy_term_id'] ?? NULL;
      if ($tid && !$lien->isEnabled()) {
        $tids[(int) $tid] = TRUE;
      }
      if ($element->subtree) {
        $parcourir($element->subtree);
      }
    }
  };
  $parcourir($arbre);
  return $tids;
}

/**
 * Arbre des rubriques publiées du vocabulaire service_au_citoyen.
 *
 * Comme dans le menu principal, une rubrique est écartée si elle est
 * dépubliée ou si son lien de menu est désactivé ; ses sous-rubriques
 * disparaissent avec elle.
 */
function _gouvernoratkin_get_services_categories_tree() {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadTree('service_au_citoyen', 0, NULL, FALSE);
  $desactives = _gouvernoratkin_services_tids_desactives();

  $tree = [];
  $terms_by_id = [];

  foreach ($terms as $term) {
    $tid = $term->tid;
    if ((isset($term->status) && !$term->status) || isset($desactives[(int) $tid])) {
      continue;
    }
    $terms_by_id[$tid] = [
      'tid' => $tid,
      'name' => $term->name,
      'children' => [],
      'parents' => [],
    ];
    
    foreach ($term->parents as $parent) {
      if ($parent != '0') {
        $terms_by_id[$tid]['parents'][] = (int) $parent;
      }
    }
  }
  
  foreach ($terms_by_id as $tid => &$term_data) {
    if (empty($term_data['parents'])) {
      $tree[$tid] = &$term_data;
    } else {
      foreach ($term_data['parents'] as $parent_id) {
        if (isset($terms_by_id[$parent_id])) {
          $terms_by_id[$parent_id]['children'][$tid] = &$term_data;
        }
      }
    }
  }
  
  return $tree;
}

/**
 * Implements hook_preprocess_page().
 */
function gouvernoratkin_preprocess_page(&$variables) {
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'entity.taxonomy_term.canonical') {
    $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
    if ($term && $term->bundle() === 'service_au_citoyen') {
      $url = \Drupal\Core\Url::fromUserInput('/services-aux-citoyens/' . $term->id());
      $response = new \Symfony\Component\HttpFoundation\RedirectResponse($url->toString());
      $response->send();
      exit;
    }
  }

  if ($alias == '/services-aux-citoyens' || strpos($alias, '/services-aux-citoyens/') === 0) {
    $variables['services_categories_tree'] = _gouvernoratkin_get_services_categories_tree();
    foreach (_gouvernoratkin_services_tree_cache_tags() as $tag) {
      $variables['#cache']['tags'][] = $tag;
    }

    $active_tid = null;
    $parts = explode('/', ltrim($alias, '/'));
    if (isset($parts[1]) && is_numeric($parts[1])) {
      $active_tid = (int) $parts[1];
    }
    $variables['active_category_tid'] = $active_tid;

    // Nom de la rubrique choisie, pour le titre de la liste.
    if ($active_tid && ($term = Term::load($active_tid)) && $term->bundle() === 'service_au_citoyen') {
      $variables['active_category_name'] = $term->label();

      // Présentation du secteur (description du terme), affichée en tête de
      // la liste : base légale commune, arrêté fixant les taux…
      if (trim((string) $term->getDescription()) !== '') {
        $variables['active_category_description'] = [
          '#type' => 'processed_text',
          '#text' => $term->getDescription(),
          '#format' => $term->getFormat(),
        ];
      }
      $variables['#cache']['tags'][] = 'taxonomy_term:' . $term->id();
    }
  }
}

/**
 * Renvoie la rubrique d'une fiche « Service au citoyen ».
 *
 * Le champ de rubrique de ce type de contenu est field_service_au_citoyen.
 * Le thème lisait field_categorie, qui n'existe pas sur ces fiches : le badge,
 * le fil d'Ariane et la rubrique active de la barre latérale restaient vides.
 * field_categorie est gardé en repli au cas où il serait ajouté plus tard.
 */
function _gouvernoratkin_service_term($node) {
  foreach (['field_service_au_citoyen', 'field_categorie'] as $field) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty() && ($term = $node->get($field)->entity)) {
      return $term;
    }
  }
  return NULL;
}

/**
 * Résumé d'une fiche pour la liste des services.
 *
 * Beaucoup de fiches commencent par reprendre leur titre en tête du texte :
 * découpé tel quel, le résumé répétait le titre juste sous celui-ci. Le titre
 * est donc retiré du début du texte avant la découpe.
 */
function _gouvernoratkin_service_resume($node, $longueur = 220) {
  if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
    return '';
  }
  $body = $node->get('body')->first();
  $texte = $body->summary ?: $body->value;
  $texte = html_entity_decode(strip_tags(str_replace('<', ' <', $texte)), ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $texte = trim(preg_replace('/\s+/u', ' ', $texte));

  $titre = trim(preg_replace('/\s+/u', ' ', $node->label()));
  if ($titre !== '' && mb_stripos($texte, $titre) === 0) {
    $texte = ltrim(mb_substr($texte, mb_strlen($titre)), " \t.:;,-–—");
  }

  return \Drupal\Component\Utility\Unicode::truncate($texte, $longueur, TRUE, TRUE);
}

/**
 * Implements hook_preprocess_node().
 */
function gouvernoratkin_preprocess_node(&$variables) {
  $node = $variables['node'] ?? NULL;
  if ($node && is_object($node) && method_exists($node, 'bundle') && $node->bundle() === 'service_au_citoyen') {
    $term = _gouvernoratkin_service_term($node);
    $variables['active_category_tid'] = $term ? (int) $term->id() : NULL;
    $variables['service_category_name'] = $term ? $term->label() : NULL;

    if ($variables['view_mode'] === 'teaser') {
      $variables['service_resume'] = _gouvernoratkin_service_resume($node);
    }
    else {
      $variables['services_categories_tree'] = _gouvernoratkin_get_services_categories_tree();
      foreach (_gouvernoratkin_services_tree_cache_tags() as $tag) {
        $variables['#cache']['tags'][] = $tag;
      }
    }
  }
}
