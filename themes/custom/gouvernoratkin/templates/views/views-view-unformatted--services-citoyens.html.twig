{#
/**
 * @file
 * Liste des démarches de la page « Services aux citoyens ».
 *
 * Les démarches sont numérotées par un compteur CSS. Avec la pagination, le
 * compteur repart du rang de la première démarche de la page : la page 2
 * commence à 11 et non à 1.
 *
 * Le message « aucun résultat » est une zone « vide » de la vue
 * services_citoyens : ce gabarit n'est appelé que s'il y a des lignes.
 */
#}
{% set rang = view.pager ? view.pager.getCurrentPage() * view.pager.getItemsPerPage() : 0 %}
<div class="services-results-list" style="counter-reset: services-counter {{ rang }};">
  {% for row in rows %}
    <div{{ row.attributes.addClass('services-result-item') }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
