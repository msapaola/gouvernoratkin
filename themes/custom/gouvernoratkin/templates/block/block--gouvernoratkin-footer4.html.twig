{#
/**
 * @file
 * Quatrième colonne du pied de page (bloc de contenu « Footer 4 »).
 *
 * La colonne n'est affichée que si le bloc contient quelque chose : texte,
 * lien ou image.
 */
#}
{%
  set classes = [
    'col-lg-3',
    'col-md-6',
    'col-12',
  ]
%}
{% set rendu = content|render %}
{% if rendu|striptags('<a><img><iframe><video>')|trim %}
<div{{ attributes.addClass(classes) }}>
  {% block content %}
    {{ rendu }}
  {% endblock %}
</div>
{% endif %}
