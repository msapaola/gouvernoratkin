{#
/**
 * @file
 * Colonne « Liens rapides » du pied de page.
 *
 * Les liens étaient saisis dans le corps du bloc, dans la base : ils
 * portaient des libellés — Gouvernance, Développement Urbain, Événements —
 * qui ne correspondaient pas aux pages du site, et le corps du bloc n'était
 * versionné nulle part.
 *
 * Ils sont décrits ici, une entrée par page réelle. Ajouter ou retirer une
 * entrée, c'est modifier le tableau ci-dessous.
 *
 * Le contenu du bloc n'est plus rendu : sa suppression côté contenu est à la
 * main des administrateurs, mais elle n'est pas nécessaire.
 */
#}
{% set liens = [
  { url: '/',                     libelle: 'Accueil'|t },
  { url: '/services-aux-citoyens', libelle: 'Services aux citoyens'|t },
  { url: '/actualites',            libelle: 'Actualités'|t },
  { url: '/structuresville',       libelle: 'Structures et services'|t },
  { url: '/a-propos',              libelle: 'À propos'|t }
] %}

{%
  set classes = [
    'col-lg-3',
    'col-md-6',
    'col-12',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  <nav class="footer-links footer-quick-links" aria-labelledby="footer-liens-titre">
    <h3 id="footer-liens-titre">{{ 'Liens rapides'|t }}</h3>
    <ul>
      {% for lien in liens %}
        <li>
          <i class="fas fa-chevron-right" aria-hidden="true"></i><a href="{{ lien.url }}">{{ lien.libelle }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</div>
