{#
/**
 * @file
 * Theme override to display primary and secondary local tasks.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing secondary tasks.
 *
 * Each item in these variables (primary and secondary) can be individually
 * themed in menu-local-task.html.twig.
 */
#}
{% if primary %}
  <h2 id="primary-tabs-title" class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  <nav class="tabs-wrapper tabs-primary" aria-labelledby="primary-tabs-title">
    <ul class="nav nav-tabs onglets primary">{{ primary }}</ul>
  </nav>
{% endif %}
{% if secondary %}
  <h2 id="secondary-tabs-title" class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <nav class="tabs-wrapper tabs-secondary" aria-labelledby="secondary-tabs-title">
    <ul class="nav nav-tabs onglets primary">{{ secondary }}</ul>
  </nav>
{% endif %}
