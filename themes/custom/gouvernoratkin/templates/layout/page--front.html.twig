{#
/**
 * @file
 * Page d'accueil du site du Gouvernorat de Kinshasa.
 *
 * Cette page est entièrement décrite ici, section par section. Les actualités,
 * les vidéos et la galerie sont injectées depuis leurs vues avec Twig Tweak, de sorte que
 * la rédaction publie normalement et que la mise en page reste sous contrôle
 * du thème.
 *
 * L'entête et le pied de page sont partagés avec page.html.twig via des
 * partiels, afin que la navigation ne soit décrite qu'à un seul endroit.
 *
 * Pour changer une image, une seule ligne à modifier : le tableau « visuels »
 * ci-dessous. Les chemins sont relatifs à la racine du site.
 *
 * Aucun texte n'est écrit ici : la rédaction les modifie dans Contenu › Blocs,
 * et le module gouvernorat_accueil les fournit à ce gabarit :
 * - « Page d'accueil » : variable accueil, une entrée par partie de la page
 *   (accueil.bandeau, accueil.acces, accueil.actualites…) avec surtitre,
 *   titre, corps, liens, image, legende et elements (cartes) ;
 * - « Mot du gouverneur » : variable gouverneur ;
 * - « Chiffres clés » : variable chiffres.
 * Une partie sans texte saisi n'affiche pas ses titres ; les listes venant
 * des vues (actualités, vidéos, galerie) restent affichées.
 */
#}
{{ attach_library('gouvernoratkin/accueil') }}

{# Visuels de la page. Ce sont des WebP recadrés aux dimensions réellement
   affichées, tirés des photographies kinhero.png et aboutville.png (2,5 Mo
   chacune, conservées dans assets/images/ comme originaux) :
   - accueil-hero.webp          1600 × 900, ~210 Ko (écrans larges) ;
   - accueil-hero-mobile.webp    720 × 960, ~75 Ko (téléphones, cadrage vertical) ;
   - accueil-apropos.webp        900 × 675, ~105 Ko.
   Pour changer une photo : produire les WebP aux mêmes dimensions (par
   exemple avec squoosh.app) et remplacer les fichiers, ou changer la ligne
   correspondante ci-dessous. Le préchargement du bandeau se règle dans
   gouvernoratkin_page_attachments_alter() (gouvernoratkin.theme). #}
{% set img = '/themes/custom/gouvernoratkin/assets/images/' %}
{% set visuels = {
  hero:        img ~ 'accueil-hero.webp',
  hero_mobile: img ~ 'accueil-hero-mobile.webp',
  apropos:     img ~ 'accueil-apropos.webp'
} %}

{% include "@gouvernoratkin/layout/partials/site-header.html.twig" %}

<main id="main-content" role="main">

  {# Messages d'etat. Sur les autres pages ils viennent du bloc place en region
     content ; cette page n'affiche pas cette region, le rendu passe donc par
     Twig Tweak. Ils apparaissent ainsi une fois et une seule. #}
  <div class="container page-messages">{{ drupal_messages() }}</div>

  {# ================= BANDEAU D'ACCUEIL ================= #}
  <section class="hero" aria-labelledby="hero-titre">
    <picture>
      <source media="(max-width: 767.98px)" srcset="{{ visuels.hero_mobile }}" width="720" height="960">
      <img class="hero__image" src="{{ visuels.hero }}" alt="" width="1600" height="900" fetchpriority="high" decoding="async">
    </picture>
    <div class="hero__voile" aria-hidden="true"></div>

    <div class="container hero__grille">
     <div class="hero__contenu">
      {% set bandeau = accueil.bandeau %}
      {% if bandeau.surtitre %}<p class="hero__surtitre">{{ bandeau.surtitre }}</p>{% endif %}
      {% if bandeau.titre %}<h1 class="hero__titre" id="hero-titre">{{ bandeau.titre }}</h1>{% endif %}
      {% if bandeau.corps %}<div class="hero__accroche">{{ bandeau.corps }}</div>{% endif %}

      {% if bandeau.liens %}
      <div class="hero__actions">
        {% for lien in bandeau.liens %}
          <a href="{{ lien.url }}" class="bouton {{ loop.first ? 'bouton--principal' : 'bouton--fantome' }}">{{ lien.titre }}</a>
        {% endfor %}
      </div>
      {% endif %}

      <div class="hero__reseaux">
        <span class="hero__reseaux-libelle">Nous suivre</span>
        <ul class="reseaux">
          <li><a href="https://x.com/gouvernoratk" class="reseaux__lien" aria-label="{{ 'Nous suivre sur X'|t }}" rel="noopener"><i class="fab fa-twitter" aria-hidden="true"></i></a></li>
          <li><a href="https://www.facebook.com/GouvKinshasa" class="reseaux__lien" aria-label="{{ 'Nous suivre sur Facebook'|t }}" rel="noopener"><i class="fab fa-facebook-f" aria-hidden="true"></i></a></li>
          <li><a href="https://www.instagram.com/gouvernoratk" class="reseaux__lien" aria-label="{{ 'Nous suivre sur Instagram'|t }}" rel="noopener"><i class="fab fa-instagram" aria-hidden="true"></i></a></li>
          <li><a href="https://youtube.com/@gouvernoratdekinshasa" class="reseaux__lien" aria-label="{{ 'Nous suivre sur YouTube'|t }}" rel="noopener"><i class="fab fa-youtube" aria-hidden="true"></i></a></li>
          <li><a href="https://www.tiktok.com/@gouvernoratk" class="reseaux__lien" aria-label="{{ 'Nous suivre sur TikTok'|t }}" rel="noopener"><i class="fab fa-tiktok" aria-hidden="true"></i></a></li>
        </ul>
      </div>
     </div>

     {# Mise en avant : l'article portant la catégorie « À la une ».
        La vue n'affiche qu'un résultat ; si aucun article ne porte cette
        catégorie, la vue ne rend rien et la colonne disparaît d'elle-même. #}
     <div class="hero__une">
       {{ drupal_view('a_la_une', 'block_1') }}
     </div>
    </div>
  </section>

  {# ================= ACCÈS RAPIDE ================= #}
  {% if accueil.acces.elements %}
  <section class="acces" aria-labelledby="acces-titre">
    <div class="container">
      <h2 class="visually-hidden" id="acces-titre">{{ accueil.acces.titre }}</h2>
      <ul class="acces__liste">
        {% for carte in accueil.acces.elements %}
        <li class="acces__item">
          <a href="{{ carte.lien.url }}" class="acces__carte acces__carte--{{ carte.couleur ?: 'bleu' }}">
            {% if carte.icone %}<span class="acces__icone" aria-hidden="true"><i class="{{ carte.icone }}"></i></span>{% endif %}
            <span class="acces__titre">{{ carte.titre }}</span>
            {% if carte.texte %}<span class="acces__texte">{{ carte.texte }}</span>{% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {# ================= MOT DU GOUVERNEUR =================
     Textes et portrait modifiables dans Contenu › Blocs, bloc de type
     « Mot du gouverneur » (variables fournies par le module
     gouvernorat_accueil). Sans bloc publié, la section n'est pas affichée. #}
  {% if gouverneur %}
  <section class="gouverneur" aria-labelledby="gouverneur-titre">
    <div class="container gouverneur__grille">
      <div class="gouverneur__texte">
        <p class="surtitre surtitre--clair">Le mot du gouverneur</p>
        <h2 class="gouverneur__titre" id="gouverneur-titre">{{ gouverneur.nom }}</h2>
        {% if gouverneur.fonction %}
          <p class="gouverneur__fonction">{{ gouverneur.fonction }}</p>
        {% endif %}

        <blockquote class="gouverneur__citation">
          {% for paragraphe in gouverneur.paragraphes %}
            <p>{{ paragraphe }}</p>
          {% endfor %}
        </blockquote>
      </div>

      {% if gouverneur.portrait %}
        <figure class="gouverneur__portrait">
          <img src="{{ gouverneur.portrait.url }}" alt="{{ gouverneur.portrait.alt }}" width="800" height="600" loading="lazy" decoding="async">
        </figure>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ================= ACTUALITÉS (vue injectée) ================= #}
  <section class="bloc bloc--clair"{% if accueil.actualites.titre %} aria-labelledby="actu-titre"{% endif %}>
    <div class="container">
      {% set sec = accueil.actualites %}
      {% if sec.titre %}
      <div class="bloc__entete">
        <div>
          {% if sec.surtitre %}<p class="surtitre">{{ sec.surtitre }}</p>{% endif %}
          <h2 class="bloc__titre" id="actu-titre">{{ sec.titre }}</h2>
        </div>
        {% if sec.liens|length > 1 %}<div class="videos-liens">{% endif %}
          {% for lien in sec.liens %}
            <a href="{{ lien.url }}" class="lien-suite"{% if lien.externe %} target="_blank" rel="noopener"{% endif %}>
              {% if 'youtube.com' in lien.url %}<i class="fab fa-youtube" aria-hidden="true"></i> {% endif %}{{ lien.titre }}{% if lien.externe %}<span class="visually-hidden"> (nouvel onglet)</span>{% else %} <i class="fas fa-arrow-right" aria-hidden="true"></i>{% endif %}
            </a>
          {% endfor %}
        {% if sec.liens|length > 1 %}</div>{% endif %}
      </div>
      {% endif %}

      <div class="bloc__contenu">
        {{ drupal_view('last_news', 'block_1') }}
      </div>
    </div>
  </section>

  {# ================= VIDÉOS (vue injectée) =================
     Les 5 dernières vidéos du type de contenu « Vidéo ». La section n'est
     affichée que si au moins une vidéo est publiée : sans cela, l'accueil
     montrerait un titre au-dessus d'un vide. #}
  {% if drupal_view_result('videos', 'block_1') %}
  {{ attach_library('gouvernoratkin/videos') }}
  <section class="bloc"{% if accueil.videos.titre %} aria-labelledby="videos-titre"{% endif %}>
    <div class="container">
      {% set sec = accueil.videos %}
      {% if sec.titre %}
      <div class="bloc__entete">
        <div>
          {% if sec.surtitre %}<p class="surtitre">{{ sec.surtitre }}</p>{% endif %}
          <h2 class="bloc__titre" id="videos-titre">{{ sec.titre }}</h2>
        </div>
        {% if sec.liens|length > 1 %}<div class="videos-liens">{% endif %}
          {% for lien in sec.liens %}
            <a href="{{ lien.url }}" class="lien-suite"{% if lien.externe %} target="_blank" rel="noopener"{% endif %}>
              {% if 'youtube.com' in lien.url %}<i class="fab fa-youtube" aria-hidden="true"></i> {% endif %}{{ lien.titre }}{% if lien.externe %}<span class="visually-hidden"> (nouvel onglet)</span>{% else %} <i class="fas fa-arrow-right" aria-hidden="true"></i>{% endif %}
            </a>
          {% endfor %}
        {% if sec.liens|length > 1 %}</div>{% endif %}
      </div>
      {% endif %}

      <div class="bloc__contenu">
        {{ drupal_view('videos', 'block_1') }}
      </div>
    </div>
  </section>
  {% endif %}


  {# ================= À PROPOS DE KINSHASA =================
     Photo : celle saisie dans la section, sinon la photo du thème. #}
  {% set apropos = accueil.apropos %}
  {% if apropos.titre %}
  <section class="apropos" aria-labelledby="apropos-titre">
    <div class="container">
      <div class="apropos__grille">
        <div class="apropos__texte">
          {% if apropos.surtitre %}<p class="surtitre">{{ apropos.surtitre }}</p>{% endif %}
          <h2 class="apropos__titre" id="apropos-titre">{{ apropos.titre }}</h2>
          {{ apropos.corps }}
          {% for lien in apropos.liens %}
            <a href="{{ lien.url }}" class="bouton bouton--principal">{{ lien.titre }}</a>
          {% endfor %}
        </div>

        <figure class="apropos__visuel">
          <img src="{{ apropos.image.url ?: visuels.apropos }}" alt="{{ apropos.image.alt ?: apropos.legende }}" width="900" height="675" loading="lazy" decoding="async">
          {% if apropos.legende %}<figcaption>{{ apropos.legende }}</figcaption>{% endif %}
        </figure>
      </div>

      {% if apropos.elements %}
      <ul class="piliers">
        {% for pilier in apropos.elements %}
        <li class="piliers__item">
          <h3 class="piliers__titre">{% if pilier.icone %}<i class="{{ pilier.icone }}" aria-hidden="true"></i> {% endif %}{{ pilier.titre }}</h3>
          {% if pilier.texte %}<p>{{ pilier.texte }}</p>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ================= CHIFFRES CLÉS =================
     Chiffres et source modifiables dans Contenu › Blocs, bloc de type
     « Chiffres clés » (variables fournies par le module gouvernorat_accueil).
     Sans bloc publié ou sans chiffre, la section n'est pas affichée. #}
  {% if chiffres.items %}
  <section class="chiffres" aria-labelledby="chiffres-titre">
    <div class="container">
      {% if accueil.chiffres.surtitre %}<p class="surtitre surtitre--clair">{{ accueil.chiffres.surtitre }}</p>{% endif %}
      {% if accueil.chiffres.titre %}<h2 class="chiffres__titre" id="chiffres-titre">{{ accueil.chiffres.titre }}</h2>{% endif %}

      <dl class="chiffres__liste">
        {% for chiffre in chiffres.items %}
          <div class="chiffres__item">
            <dt class="chiffres__valeur">{{ chiffre.valeur }}</dt>
            <dd class="chiffres__libelle">{{ chiffre.libelle }}</dd>
          </div>
        {% endfor %}
      </dl>

      {% if chiffres.source %}
        <p class="chiffres__source">{{ chiffres.source }}</p>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ================= GALERIE (vue injectée) ================= #}
  <section class="bloc"{% if accueil.galerie.titre %} aria-labelledby="galerie-titre"{% endif %}>
    <div class="container">
      {% set sec = accueil.galerie %}
      {% if sec.titre %}
      <div class="bloc__entete">
        <div>
          {% if sec.surtitre %}<p class="surtitre">{{ sec.surtitre }}</p>{% endif %}
          <h2 class="bloc__titre" id="galerie-titre">{{ sec.titre }}</h2>
        </div>
        {% if sec.liens|length > 1 %}<div class="videos-liens">{% endif %}
          {% for lien in sec.liens %}
            <a href="{{ lien.url }}" class="lien-suite"{% if lien.externe %} target="_blank" rel="noopener"{% endif %}>
              {% if 'youtube.com' in lien.url %}<i class="fab fa-youtube" aria-hidden="true"></i> {% endif %}{{ lien.titre }}{% if lien.externe %}<span class="visually-hidden"> (nouvel onglet)</span>{% else %} <i class="fas fa-arrow-right" aria-hidden="true"></i>{% endif %}
            </a>
          {% endfor %}
        {% if sec.liens|length > 1 %}</div>{% endif %}
      </div>
      {% endif %}

      <div class="bloc__contenu">
        {{ drupal_view('gallery_accueil', 'block_1') }}
      </div>
    </div>
  </section>

  {# ================= DÉMARCHES LES PLUS DEMANDÉES =================
     Cartes saisies dans la section « Démarches les plus demandées » : chacune
     mène à une rubrique des services aux citoyens. #}
  {% set demarches = accueil.demarches %}
  {% if demarches.elements %}
  <section class="bloc bloc--clair"{% if demarches.titre %} aria-labelledby="themes-titre"{% endif %}>
    {% if demarches.titre %}
    <div class="container">
      <div class="bloc__entete bloc__entete--centre">
        <div>
          {% if demarches.surtitre %}<p class="surtitre">{{ demarches.surtitre }}</p>{% endif %}
          <h2 class="bloc__titre" id="themes-titre">{{ demarches.titre }}</h2>
        </div>
      </div>
    </div>
    {% endif %}

    <div class="container">
      <ul class="themes">
        {% for carte in demarches.elements %}
        <li class="themes__item">
          <a href="{{ carte.lien.url }}" class="themes__carte">
            {% if carte.icone %}<span class="themes__icone themes__icone--{{ carte.couleur ?: 'bleu' }}" aria-hidden="true"><i class="{{ carte.icone }}"></i></span>{% endif %}
            <span class="themes__corps">
              <span class="themes__titre">{{ carte.titre }}</span>
              {% if carte.texte %}<span class="themes__texte">{{ carte.texte }}</span>{% endif %}
              {% if carte.lien.titre %}<span class="themes__suite">{{ carte.lien.titre }} <i class="fas fa-arrow-right" aria-hidden="true"></i></span>{% endif %}
            </span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  {# ================= APPEL AUX DÉMARCHES ================= #}
  {% set appel = accueil.appel %}
  {% if appel.titre %}
  <section class="appel" aria-labelledby="appel-titre">
    <div class="container appel__contenu">
      <h2 class="appel__titre" id="appel-titre">{{ appel.titre }}</h2>
      {% if appel.corps %}<div class="appel__texte">{{ appel.corps }}</div>{% endif %}
      {% if appel.liens %}
      <div class="appel__actions">
        {% for lien in appel.liens %}
          <a href="{{ lien.url }}" class="bouton {{ loop.first ? 'bouton--principal' : 'bouton--fantome' }}">{{ lien.titre }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
