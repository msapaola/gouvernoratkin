<!--========== END TWIG CLASSES ==========--> 
<!-- Navigation area start -->
    <header>
    <nav class="navbar navbar-expand-lg">
      <div class="container">
        {% if page.logo %}
          {{page.logo}}
        {% endif %}
        
        <!-- Boutons à droite sur mobile (recherche et contact) -->
        <div class="d-flex d-lg-none mobile-actions">
          <button type="button" class="popup-button" aria-label="{{ 'Rechercher'|t }}"><i class="fas fa-search" aria-hidden="true"></i></button>
          <a href="/contact" class="btn-contact-mobile" aria-label="{{ 'Nous contacter'|t }}">
            <i class="fas fa-envelope" aria-hidden="true"></i>
          </a>
        </div>
        
        <!-- Bouton hamburger -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="{{ 'Ouvrir le menu'|t }}">
          <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
        
        <!-- Menu principal -->
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          {% if page.menu %}
            {{page.menu}}
          {% endif %}
          
          <!-- Boutons à droite sur desktop (recherche et contact) -->
          <div class="d-none d-lg-flex align-items-center">
            <button type="button" class="popup-button" aria-label="{{ 'Rechercher'|t }}"><i class="fas fa-search" aria-hidden="true"></i></button>
            <a href="/contact" class="btn btn-contact">Contact</a>
          </div>
        </div>
      </div>
    </nav>
  </header>

 <!-- Navigation area end --> 

<!-- Zone systeme start -->
{#
  Fil d'Ariane.

  Le theme ne place aucun bloc de fil d'Ariane : il n'en figurait aucun parmi
  ses 26 blocs configures, alors que les quatre autres themes du site en ont
  un. Le rendu passe donc par Twig Tweak, ce qui le versionne avec le theme.

  Les messages d'etat et les onglets locaux, eux, sont rendus par des blocs
  places en region et ne doivent pas etre rendus ici : le bloc
  gouvernoratkin_onglets (local_tasks_block) est place en region content, et un
  bloc de messages a ete ajoute cote configuration. Les rendre une seconde fois
  depuis ce gabarit produisait un affichage en double.

  Le fil d'Ariane est provisoirement place ici ; il rejoindra la banniere de
  titre lors de l'unification des entetes de page.
#}
<div class="system-area">
  <div class="container">
    {% if not is_front %}
      {{ drupal_breadcrumb() }}
    {% endif %}
  </div>
</div>
<!-- Zone systeme end -->
  
 
  {% if page.top_menu %}
  
      <div class="container">
          {{page.top_menu}}
      </div>
  
   {% endif %}
   
{# Cible du lien d'evitement declare dans html.html.twig, qui pointait vers un
   identifiant main-content absent de la page. #}
<main id="main-content" role="main">

   <!--========== BEGIN CONTENT ==========--> 
				{% if page.content %}
					{{ page.content }}
				{% endif %}
		
<!--========== END CONTENT ==========--> 
