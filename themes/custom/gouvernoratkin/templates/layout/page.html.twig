 
 
 <!--========== BEGIN TWIG CLASSES ==========--> 
 {% 
  set logo_classes = (page.logo) ? 'col-3' : ''
  %} 

  {% 
  set menu_classes = (page.menu) ? 'col-6' : ''
  %} 

  {% 
  set sidebar_classes = (page.sidebar) ? 'col-3' : ''
  %} 
  
  {% 
  set singlepost_classes = (page.singlepost) ? 'blog-details pt-100' : ''  
  %}

 
<!--========== END TWIG CLASSES ==========--> 
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" %}

{# Cible du lien d'evitement declare dans html.html.twig, qui pointait vers un
   identifiant main-content absent de la page. #}
<main id="main-content" role="main">

   <!--========== BEGIN CONTENT ==========--> 
				{% if page.content %}
					{{ page.content }}
				{% endif %}
		
<!--========== END CONTENT ==========--> 

 

<!-- Single Post Gallery Area Start -->
{% if page.singlepostgallery %}
        {{ page.singlepostgallery }}
{% endif %} 
<!-- Single Post Gallery Area End -->

<!-- Upcoming Events area Start -->
{% if page.events %}
        <section class="container pt-100">
            <div class="default-section-title default-section-title-middle">
             <h2>Événements à venir</h2>
              <p>Kinshasa Action : Ne Manquez Rien !</p>
             </div>
                {{ page.events }}
        </section>
{% endif %} 
<!-- Upcoming Events Area End -->

<!-- Blog Details Area Start -->
{% if page.singlepost %}
 <section class="{{ singlepost_classes }}">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
               {{ page.singlepost }}
            </div>
            <div class="col-lg-4">
                <div class="sidebar-area pl-20 pt-30">
                {{ page.singlepost_sidebar }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}  
<!-- Blog Details Area End -->

<!-- Events Details area Start --> 
{% if page.singlepostevents %}
        <section class="event-details pb-100">
             {{ page.singlepostevents }}
        </section>
{% endif %}       

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
