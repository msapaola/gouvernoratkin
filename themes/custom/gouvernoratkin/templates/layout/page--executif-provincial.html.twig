{#
/**
 * @file
 * Page « Exécutif provincial » du site du Gouvernorat de Kinshasa.
 *
 * Le gabarit reprend l'entête sobre de la page « À propos » — même filet
 * tricolore, même fil d'Ariane — pour que les pages institutionnelles du site
 * s'ouvrent toutes de la même façon.
 *
 * Le corps se construit à partir des fiches « Membre » (variable membres,
 * fournie par le module gouvernorat_institutions) : une fiche par personne,
 * modifiable sans toucher au code ni au HTML. Les noms et les fonctions
 * changent au gré des nominations ; ils n'ont pas à être figés ici.
 *
 * La vue executif_provincial ne sert plus qu'à fournir l'adresse de la page :
 * son contenu (l'ancien bloc HTML n° 10) n'est plus affiché.
 */
#}
{{ attach_library('gouvernoratkin/membres') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

<main id="main-content" role="main">

  {# ================= ENTÊTE ================= #}
  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">Exécutif provincial</li>
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        {% set entete = textes.entete_executif %}
        {% if entete.surtitre %}<p class="surtitre">{{ entete.surtitre }}</p>{% endif %}
        {% if entete.titre %}<h1 class="page-entete__titre">{{ entete.titre }}</h1>{% endif %}
        {% if entete.corps %}<div class="page-entete__accroche">{{ entete.corps }}</div>{% endif %}
      </div>
    </div>
  </header>

  {# ================= CORPS ================= #}
  <div class="membres-corps">
    <div class="container page-messages">{{ drupal_messages() }}</div>

    <div class="container">
      {% include "@gouvernoratkin/layout/partials/membres-section.html.twig" with { cle: 'gouvernorat', titre: 'Gouverneur et vice-gouverneur', liste: membres.gouvernorat, variante: 'large' } only %}
      {% include "@gouvernoratkin/layout/partials/membres-section.html.twig" with { cle: 'ministres', titre: 'Ministres provinciaux', liste: membres.ministres } only %}
      {% include "@gouvernoratkin/layout/partials/membres-section.html.twig" with { cle: 'secretariat', titre: 'Secrétariat exécutif', liste: membres.secretariat } only %}

      {% if user.hasPermission('edit any membre content') %}
        <p class="membres-gestion">
          <a href="/admin/content?type=membre">Gérer les fiches des membres</a>
        </p>
      {% endif %}
    </div>
  </div>

  {# Passerelle vers les autres pages de gouvernance : la page se terminait
     sans issue, alors que le cabinet et les structures de la ville la
     prolongent naturellement. #}
  {% if textes.suite_executif.titre %}
  <section class="page-appel" aria-labelledby="ex-suite-titre">
    <div class="container">
      {% set suite = textes.suite_executif %}
      <h2 class="page-appel__titre" id="ex-suite-titre">{{ suite.titre }}</h2>
      {% if suite.corps %}<div class="page-appel__texte">{{ suite.corps }}</div>{% endif %}
      <div class="page-appel__actions">
        {% for lien in suite.liens %}
          <a href="{{ lien.url }}" class="bouton {{ loop.first ? 'bouton--clair' : 'bouton--fantome' }}">{{ lien.titre }}</a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
