{#
/**
 * @file
 * Page « Exécutif provincial » du site du Gouvernorat de Kinshasa.
 *
 * Le gabarit reprend l'entête sobre de la page « À propos » — même filet
 * tricolore, même fil d'Ariane — pour que les pages institutionnelles du site
 * s'ouvrent toutes de la même façon.
 *
 * Le corps reste le contenu saisi dans l'éditeur, rendu par la vue
 * executif_provincial : les noms et les fonctions des membres de l'exécutif
 * changent au gré des nominations, ils n'ont pas à être figés dans le thème.
 * Ce sont ses styles qui reviennent au thème, via assets/css/executif.css,
 * en remplacement de la feuille injectée hors du dépôt.
 */
#}
{{ attach_library('gouvernoratkin/executif') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

<main id="main-content" role="main">

  {# ================= ENTÊTE ================= #}
  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item"><a href="/a-propos">Gouvernance</a></li>
          <li class="breadcrumb-item active" aria-current="page">Exécutif provincial</li>
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        <p class="surtitre">Gouvernance</p>
        <h1 class="page-entete__titre">L'exécutif provincial</h1>
        <p class="page-entete__accroche">
          Le gouverneur et les ministres provinciaux conduisent l'action de la
          Ville-Province de Kinshasa. Chacun porte un portefeuille et répond des
          politiques publiques menées dans son domaine auprès des Kinoises et
          des Kinois.
        </p>
      </div>
    </div>
  </header>

  {# ================= CORPS ================= #}
  <div class="ex-corps">
    <div class="container page-messages">{{ drupal_messages() }}</div>

    <div class="container">
      {{ page.content }}
    </div>
  </div>

  {# Passerelle vers les autres pages de gouvernance : la page se terminait
     sans issue, alors que le cabinet et les structures de la ville la
     prolongent naturellement. #}
  <section class="page-appel" aria-labelledby="ex-suite-titre">
    <div class="container">
      <h2 class="page-appel__titre" id="ex-suite-titre">Poursuivre la découverte</h2>
      <p class="page-appel__texte">
        Le cabinet du gouverneur et les structures de la Ville-Province
        complètent l'organisation de l'exécutif provincial.
      </p>
      <div class="page-appel__actions">
        <a href="/cabinet-du-gouverneur" class="bouton bouton--clair">Le cabinet du gouverneur</a>
        <a href="/structuresville" class="bouton bouton--fantome">Les structures de la ville</a>
      </div>
    </div>
  </section>

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
