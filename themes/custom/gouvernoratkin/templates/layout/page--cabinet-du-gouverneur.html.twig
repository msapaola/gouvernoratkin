{#
/**
 * @file
 * Page « Cabinet du gouverneur » du site du Gouvernorat de Kinshasa.
 *
 * Même entête que les autres pages institutionnelles — filet tricolore, fil
 * d'Ariane à un seul niveau — pour qu'elles s'ouvrent toutes de la même façon.
 *
 * Le corps se construit à partir des fiches « Membre » de l'instance
 * « Cabinet du gouverneur » (variable membres, fournie par le module
 * gouvernorat_institutions). Le premier membre dont le champ « Mot » est
 * rempli — le directeur de cabinet — ouvre la page avec son mot.
 *
 * La vue cabinet_du_gouverneur ne sert plus qu'à fournir l'adresse de la
 * page : son contenu (l'ancien bloc HTML n° 23) n'est plus affiché.
 */
#}
{{ attach_library('gouvernoratkin/membres') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

<main id="main-content" role="main">

  {# ================= ENTÊTE ================= #}
  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">Cabinet du gouverneur</li>
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        <p class="surtitre">Gouvernance</p>
        <h1 class="page-entete__titre">Le cabinet du gouverneur</h1>
        <p class="page-entete__accroche">
          Le cabinet assiste le gouverneur dans la conduite de l'action publique
          provinciale : préparation des décisions, coordination des services et
          suivi de leur mise en œuvre au bénéfice des Kinoises et des Kinois.
        </p>
      </div>
    </div>
  </header>

  {# ================= CORPS ================= #}
  <div class="membres-corps">
    <div class="container page-messages">{{ drupal_messages() }}</div>

    {# Mot du directeur de cabinet : le premier membre qui a un mot. #}
    {% set auteur = (membres.cabinet|default([])|filter(membre => membre.mot))|first %}

    {% if auteur %}
      <section class="membres-mot" aria-labelledby="membres-mot-titre">
        <div class="container">
          <div class="membres-mot__grille">
            <div class="membres-mot__photo">
              {% if auteur.photo %}
                <img src="{{ auteur.photo.url }}" alt="{{ auteur.photo.alt }}" width="480" height="600" loading="lazy" decoding="async">
              {% else %}
                <span class="membre-carte__initiales" aria-hidden="true">{{ auteur.initiales }}</span>
              {% endif %}
            </div>
            <div class="membres-mot__texte">
              <p class="surtitre">{{ auteur.fonction }}</p>
              <h2 class="membres-section__titre" id="membres-mot-titre">Le mot du cabinet</h2>
              <blockquote class="membres-mot__citation">
                {% for paragraphe in auteur.mot %}
                  <p>{{ paragraphe }}</p>
                {% endfor %}
              </blockquote>
              <p class="membres-mot__signature">
                <strong>{{ auteur.nom }}</strong>, {{ auteur.fonction }}
              </p>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <div class="container">
      {% include "@gouvernoratkin/layout/partials/membres-section.html.twig" with { cle: 'cabinet', titre: 'Équipe du cabinet', liste: membres.cabinet } only %}

      {% if user.hasPermission('edit any membre content') %}
        <p class="membres-gestion">
          <a href="/admin/content?type=membre">Gérer les fiches des membres</a>
        </p>
      {% endif %}
    </div>
  </div>

  {# ================= POURSUIVRE ================= #}
  <section class="page-appel" aria-labelledby="suite-titre">
    <div class="container">
      <h2 class="page-appel__titre" id="suite-titre">Poursuivre la découverte</h2>
      <p class="page-appel__texte">
        L'exécutif provincial et les structures de la Ville-Province complètent
        l'organisation du Gouvernorat de Kinshasa.
      </p>
      <div class="page-appel__actions">
        <a href="/executif-provincial" class="bouton bouton--clair">L'exécutif provincial</a>
        <a href="/structuresville" class="bouton bouton--fantome">Les structures de la ville</a>
      </div>
    </div>
  </section>

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
