{#
/**
 * @file
 * Page « Cabinet du gouverneur » du site du Gouvernorat de Kinshasa.
 *
 * Même entête que les autres pages institutionnelles — filet tricolore, fil
 * d'Ariane à un seul niveau — pour qu'elles s'ouvrent toutes de la même façon.
 *
 * Le corps reste le contenu saisi dans l'éditeur, rendu par la vue
 * cabinet_du_gouverneur. Ce sont ses styles qui reviennent au thème, via
 * assets/css/cabinet.css, en remplacement de la feuille injectée hors du dépôt.
 */
#}
{{ attach_library('gouvernoratkin/cabinet') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

<main id="main-content" role="main">

  {# ================= ENTÊTE ================= #}
  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">Cabinet du gouverneur</li>
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        <p class="surtitre">Gouvernance</p>
        <h1 class="page-entete__titre">Le cabinet du gouverneur</h1>
        <p class="page-entete__accroche">
          Le cabinet assiste le gouverneur dans la conduite de l'action publique
          provinciale : préparation des décisions, coordination des services et
          suivi de leur mise en œuvre au bénéfice des Kinoises et des Kinois.
        </p>
      </div>
    </div>
  </header>

  {# ================= CORPS ================= #}
  <div class="cab-corps">
    <div class="container page-messages">{{ drupal_messages() }}</div>
    {{ page.content }}
  </div>

  {# ================= POURSUIVRE ================= #}
  <section class="page-appel" aria-labelledby="suite-titre">
    <div class="container">
      <h2 class="page-appel__titre" id="suite-titre">Poursuivre la découverte</h2>
      <p class="page-appel__texte">
        L'exécutif provincial et les structures de la Ville-Province complètent
        l'organisation du Gouvernorat de Kinshasa.
      </p>
      <div class="page-appel__actions">
        <a href="/executif-provincial" class="bouton bouton--clair">L'exécutif provincial</a>
        <a href="/structuresville" class="bouton bouton--fantome">Les structures de la ville</a>
      </div>
    </div>
  </section>

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
