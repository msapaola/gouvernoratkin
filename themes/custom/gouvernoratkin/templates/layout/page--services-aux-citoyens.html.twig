{#
/**
 * @file
 * Page « Services aux citoyens » du site du Gouvernorat de Kinshasa.
 *
 * Le gabarit recopiait la barre de navigation et le pied de page en clair,
 * et embarquait son propre script de dépliage. Il passe désormais par les
 * partiels du thème et par la bibliothèque gouvernoratkin/services, comme
 * les autres pages.
 *
 * L'entête est celui des autres pages institutionnelles ; la recherche prend
 * place juste en dessous, dans sa propre bande claire.
 *
 * Les variables services_categories_tree, active_category_tid et
 * active_category_name viennent du prétraitement du thème. La barre latérale
 * est le partiel services-sidebar.html.twig, partagé avec la fiche d'une
 * démarche.
 */
#}
{{ attach_library('gouvernoratkin/services') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

{% set recherche = app.request.query.get('title') %}
{% set suffixe = recherche ? '?title=' ~ recherche|url_encode : '' %}

<main id="main-content" role="main">

  {# ================= ENTÊTE ================= #}
  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          {% if active_category_name %}
            <li class="breadcrumb-item"><a href="/services-aux-citoyens">Services aux citoyens</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ active_category_name }}</li>
          {% else %}
            <li class="breadcrumb-item active" aria-current="page">Services aux citoyens</li>
          {% endif %}
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        <p class="surtitre">Vos démarches</p>
        <h1 class="page-entete__titre">Services aux citoyens</h1>
        <p class="page-entete__accroche">
          Retrouvez l'ensemble des démarches et services proposés par le
          Gouvernorat de Kinshasa à la population kinoise : pièces à fournir,
          étapes et lieux de dépôt.
        </p>
      </div>
    </div>
  </header>

  {# ================= RECHERCHE ================= #}
  <div class="serv-recherche">
    <div class="container">
      <div class="services-search-bar">
        <form action="" method="get" class="services-search-form" role="search">
          <div class="search-input-wrapper">
            <i class="fas fa-search search-icon-decorative" aria-hidden="true"></i>
            <label class="visually-hidden" for="services-search-input">{{ 'Rechercher une démarche'|t }}</label>
            <input
              type="search"
              name="title"
              id="services-search-input"
              class="services-search-input"
              placeholder="Rechercher une démarche (ex : naissance, permis, acte ...)"
              autocomplete="off"
              value="{{ recherche }}"
            />
            <button type="submit" class="services-search-btn">
              <i class="fas fa-search me-2" aria-hidden="true"></i>Rechercher
            </button>
          </div>
        </form>
      </div>
      {% if recherche %}
        <p class="serv-recherche__aide">
          Résultats pour « {{ recherche }} ».
          <a href="/services-aux-citoyens">Afficher toutes les démarches</a>
        </p>
      {% endif %}
    </div>
  </div>

  {# ================= CORPS : LISTE ET RUBRIQUES ================= #}
  <div class="container page-messages">{{ drupal_messages() }}</div>

  <div class="container services-page-body">
    <div class="row g-4">

      <div class="col-lg-8 col-md-12">
        <div class="services-list-header">
          <h2 class="services-list-title">{{ active_category_name ?: 'Tous les services' }}</h2>
          {% if active_category_tid %}
            <a href="/services-aux-citoyens{{ suffixe }}" class="services-list-reset">
              <i class="fas fa-times" aria-hidden="true"></i> Toutes les rubriques
            </a>
          {% endif %}
        </div>
        <div class="services-list-container">
          {{ page.content }}
        </div>
      </div>

      <div class="col-lg-4 col-md-12">
        {% include "@gouvernoratkin/layout/partials/services-sidebar.html.twig" %}
      </div>

    </div>
  </div>

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
