{#
/**
 * @file
 * Page « Services aux citoyens » du site du Gouvernorat de Kinshasa.
 *
 * Le gabarit recopiait la barre de navigation et le pied de page en clair,
 * et embarquait son propre script de dépliage. Il passe désormais par les
 * partiels du thème et par la bibliothèque gouvernoratkin/services, comme
 * les autres pages.
 *
 * L'entête est celui des autres pages institutionnelles ; la recherche prend
 * place juste en dessous, dans sa propre bande claire.
 *
 * Les variables services_categories_tree et active_category_tid viennent du
 * prétraitement du thème.
 */
#}
{{ attach_library('gouvernoratkin/services') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

{% set recherche = app.request.query.get('title') %}
{% set suffixe = recherche ? '?title=' ~ recherche|url_encode : '' %}

<main id="main-content" role="main">

  {# ================= ENTÊTE ================= #}
  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">Services aux citoyens</li>
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        <p class="surtitre">Vos démarches</p>
        <h1 class="page-entete__titre">Services aux citoyens</h1>
        <p class="page-entete__accroche">
          Retrouvez l'ensemble des démarches et services proposés par le
          Gouvernorat de Kinshasa à la population kinoise : pièces à fournir,
          étapes et lieux de dépôt.
        </p>
      </div>
    </div>
  </header>

  {# ================= RECHERCHE ================= #}
  <div class="serv-recherche">
    <div class="container">
      <div class="services-search-bar">
        <form action="" method="get" class="services-search-form" role="search">
          <div class="search-input-wrapper">
            <i class="fas fa-search search-icon-decorative" aria-hidden="true"></i>
            <label class="visually-hidden" for="services-search-input">{{ 'Rechercher une démarche'|t }}</label>
            <input
              type="search"
              name="title"
              id="services-search-input"
              class="services-search-input"
              placeholder="Rechercher une démarche (ex : naissance, permis, acte ...)"
              autocomplete="off"
              value="{{ recherche }}"
            />
            <button type="submit" class="services-search-btn">
              <i class="fas fa-search me-2" aria-hidden="true"></i>Rechercher
            </button>
          </div>
        </form>
      </div>
      {% if recherche %}
        <p class="serv-recherche__aide">
          Résultats pour « {{ recherche }} ».
          <a href="/services-aux-citoyens">Afficher toutes les démarches</a>
        </p>
      {% endif %}
    </div>
  </div>

  {# ================= CORPS : LISTE ET RUBRIQUES ================= #}
  <div class="container page-messages">{{ drupal_messages() }}</div>

  <div class="container services-page-body">
    <div class="row g-4">

      <div class="col-lg-8 col-md-12">
        <div class="services-list-header">
          <h2 class="services-list-title">Tous les services</h2>
        </div>
        <div class="services-list-container">
          {{ page.content }}
        </div>
      </div>

      <div class="col-lg-4 col-md-12">
        <div class="services-sidebar">

          <a href="/services-aux-citoyens{{ suffixe }}" class="sidebar-main-header-link {{ not active_category_tid ? 'active' }}">
            <i class="fas fa-hands-helping me-2" aria-hidden="true"></i>Services aux citoyens
          </a>

          <ul class="sidebar-categories-list">
            {% for root in services_categories_tree %}
              {% for category in root.children %}
                {% set has_active_child = false %}
                {% for grandchild in category.children %}
                  {% if grandchild.tid == active_category_tid %}
                    {% set has_active_child = true %}
                  {% endif %}
                {% endfor %}
                {% set deplie = category.tid == active_category_tid or has_active_child %}

                <li class="sidebar-parent-item {{ deplie ? 'expanded' }}">
                  {% if category.children is not empty %}
                    {# Un bouton, et non un div muni d'un ecouteur de clic :
                       le depliage devient atteignable au clavier et son etat
                       est annonce aux lecteurs d'ecran. #}
                    <button type="button" class="sidebar-parent-header {{ deplie ? 'active' }}" aria-expanded="{{ deplie ? 'true' : 'false' }}">
                      <span class="cat-label">{{ category.name }}</span>
                      <span class="cat-toggle-icon"><i class="fas {{ deplie ? 'fa-chevron-down' : 'fa-chevron-right' }}" aria-hidden="true"></i></span>
                    </button>
                    <ul class="sidebar-child-list">
                      {% for grandchild in category.children %}
                        <li class="sidebar-child-item {{ grandchild.tid == active_category_tid ? 'active' }}">
                          <a href="/services-aux-citoyens/{{ grandchild.tid }}{{ suffixe }}" class="sidebar-child-link">
                            {{ grandchild.name }}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% else %}
                    <a href="/services-aux-citoyens/{{ category.tid }}{{ suffixe }}" class="sidebar-parent-link-direct {{ category.tid == active_category_tid ? 'active' }}">
                      <span class="cat-label">{{ category.name }}</span>
                      <span class="cat-arrow"><i class="fas fa-chevron-right" aria-hidden="true"></i></span>
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
            {% endfor %}
          </ul>

          <div class="sidebar-help-box">
            <div class="sidebar-help-icon">
              <i class="fas fa-headset" aria-hidden="true"></i>
            </div>
            <div class="sidebar-help-content">
              <h3>Besoin d'aide ?</h3>
              <p>Contactez nos agents pour vous accompagner dans vos démarches.</p>
              <a href="/contact" class="sidebar-help-btn">
                <i class="fas fa-envelope me-2" aria-hidden="true"></i>Nous contacter
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
