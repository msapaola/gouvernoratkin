{#
/**
 * @file
 * Page « Galerie photo » du site du Gouvernorat de Kinshasa.
 *
 * Même entête que les autres pages du site. Les cartes sont rendues par la
 * vue all_gallery ; assets/css/galerie.css reprend leurs styles, jusqu'ici
 * portés par une feuille injectée hors du dépôt.
 */
#}
{{ attach_library('gouvernoratkin/galerie') }}

{# Le fil d'Ariane générique du partiel est neutralisé : cette page pose le
   sien dans son entête, au-dessus du titre. #}
{% include "@gouvernoratkin/layout/partials/site-header.html.twig" with { sans_fil_ariane: true } %}

<main id="main-content" role="main">

  <header class="page-entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">Galerie photo</li>
        </ol>
      </nav>

      <div class="page-entete__contenu">
        <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
        <p class="surtitre">En images</p>
        <h1 class="page-entete__titre">Galerie photo du Gouvernorat</h1>
        <p class="page-entete__accroche">
          Les activités et les événements de la Ville-Province de Kinshasa,
          racontés en images.
        </p>
      </div>
    </div>
  </header>

  <div class="gal-corps">
    <div class="container page-messages">{{ drupal_messages() }}</div>
    <div class="container">
      {{ page.content }}
    </div>
  </div>

</main>

{% include "@gouvernoratkin/layout/partials/site-footer.html.twig" %}
