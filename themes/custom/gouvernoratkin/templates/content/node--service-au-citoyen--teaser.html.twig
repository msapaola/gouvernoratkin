{#
/**
 * @file
 * Démarche « Service au citoyen » dans la liste des services.
 *
 * Variables :
 * - label, url : titre et lien de la fiche ;
 * - service_category_name : rubrique de la fiche (champ
 *   field_service_au_citoyen), fournie par le prétraitement du thème ;
 * - service_resume : début du texte, sans le titre que beaucoup de fiches
 *   reprennent en tête du corps (le titre s'affichait alors deux fois).
 */
#}
<article class="service-teaser-item">

  {% if service_category_name %}
    <div class="service-teaser-category">
      <i class="fas fa-tag me-1" aria-hidden="true"></i>
      {{ service_category_name }}
    </div>
  {% endif %}

  {{ title_prefix }}
  <h3 class="service-teaser-title">
    <a href="{{ url }}">{{ label }}</a>
  </h3>
  {{ title_suffix }}

  {% if service_resume %}
    <p class="service-teaser-summary">{{ service_resume }}</p>
  {% endif %}

  <a href="{{ url }}" class="service-teaser-readmore">
    En savoir plus<span class="visually-hidden"> : {{ label }}</span> <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
  </a>

</article>
