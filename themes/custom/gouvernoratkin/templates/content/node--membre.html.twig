{#
/**
 * @file
 * Page d'un membre (gouvernorat/nom-de-la-personne).
 *
 * Variables (module gouvernorat_institutions) :
 * - membre : carte préparée par gouvernorat_institutions_carte(), plus
 *   instance, instance_libelle et biographie (texte mis en forme, facultatif) ;
 * - autres_membres, autres_titre : les autres personnes de la même instance
 *   (les ministres pour le gouverneur et le vice-gouverneur).
 *
 * La page se limitait à une photo et deux lignes (rapport, § 10.4). Elle
 * s'ouvre désormais comme les autres pages institutionnelles, présente la
 * biographie quand elle est saisie et se prolonge par les autres membres.
 */
#}
{{ attach_library('gouvernoratkin/membres') }}
{% set retour = membre.instance == 'cabinet'
  ? { url: '/cabinet-du-gouverneur', libelle: 'Le cabinet du gouverneur', ariane: 'Cabinet du gouverneur' }
  : { url: '/executif-provincial', libelle: "L'exécutif provincial", ariane: 'Exécutif provincial' } %}

<article{{ attributes.addClass('membre-fiche') }}>

  <header class="page-entete membre-fiche__entete">
    <div class="container">
      <nav aria-label="{{ 'Fil d’Ariane'|t }}">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" aria-hidden="true"></i> Accueil</a></li>
          <li class="breadcrumb-item"><a href="{{ retour.url }}">{{ retour.ariane }}</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{ label }}</li>
        </ol>
      </nav>
      <p class="page-entete__filet" aria-hidden="true"><span></span><span></span><span></span></p>
      {% if membre.instance_libelle %}
        <p class="surtitre">{{ membre.instance_libelle }}</p>
      {% endif %}
      {# Le bloc de titre de Drupal est masqué sur les pages de contenu : chaque
         gabarit pose le sien. #}
      {{ title_prefix }}
      <h1 class="page-entete__titre membre-fiche__nom">{{ label }}</h1>
      {{ title_suffix }}
      <p class="membre-fiche__fonction">{{ membre.fonction }}</p>
    </div>
  </header>

  <div class="membre-fiche__corps">
    <div class="container">
      <div class="membre-fiche__grille">
        <div class="membre-carte__photo membre-fiche__photo">
          {% if membre.photo %}
            <img src="{{ membre.photo.url }}" alt="{{ membre.photo.alt }}" width="480" height="600" decoding="async">
          {% else %}
            <span class="membre-carte__initiales" aria-hidden="true">{{ membre.initiales }}</span>
          {% endif %}
        </div>

        <div class="membre-fiche__texte">
          {% if membre.description %}
            <p class="membre-fiche__chapo">{{ membre.description }}</p>
          {% endif %}

          {% if membre.biographie %}
            <div class="membre-fiche__biographie">
              <h2>Biographie et parcours</h2>
              {{ membre.biographie }}
            </div>
          {% endif %}

          {% if membre.mot %}
            <blockquote class="membres-mot__citation">
              {% for paragraphe in membre.mot %}
                <p>{{ paragraphe }}</p>
              {% endfor %}
            </blockquote>
          {% endif %}

          {% if not membre.biographie and peut_modifier %}
            <p class="membre-fiche__aide">
              Cette fiche n'a pas encore de biographie.
              <a href="{{ path('entity.node.edit_form', {'node': node.id}) }}">Ajouter une biographie</a>
              (champ « Biographie et parcours »).
            </p>
          {% endif %}

          <p class="membre-fiche__retour">
            <a href="{{ retour.url }}" class="lien-suite"><i class="fas fa-arrow-left" aria-hidden="true"></i> {{ retour.libelle }}</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  {% if autres_membres %}
    <div class="membre-fiche__autres">
      <div class="container">
        {% include "@gouvernoratkin/layout/partials/membres-section.html.twig" with { cle: 'autres', titre: autres_titre, liste: autres_membres } only %}
      </div>
    </div>
  {% endif %}

</article>
