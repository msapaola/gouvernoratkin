# Réglages du conteneur. Copier ce fichier en « .env » (même dossier) et le
# remplir. Le fichier .env contient des secrets : il ne doit JAMAIS être
# versionné ni envoyé par message.

# --- Adresse du site ---------------------------------------------------------
# « :80 » : HTTP seul (essai, ou derrière un autre proxy HTTPS).
# « kinshasa.cd, www.kinshasa.cd » : HTTPS automatique (Let's Encrypt).
SITE_ADDRESS=:80
# Noms de domaine acceptés par Drupal, séparés par des virgules.
DOMAINES=kinshasa.cd,www.kinshasa.cd,localhost
# 1 = demander aux moteurs de ne pas indexer (site de test).
NOINDEX=0

# --- Base de données ---------------------------------------------------------
# 127.0.0.1 = la base est dans le conteneur. Autre valeur (nom ou adresse d'un
# serveur MySQL/MariaDB) = base externe ; MariaDB n'est alors pas démarré.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
# Mot de passe long et aléatoire, par exemple : openssl rand -base64 24
DB_PASSWORD=
# « cu68_ » si la base vient telle quelle de l'hébergement actuel.
DB_PREFIX=cu68_

# --- Drupal ------------------------------------------------------------------
# Reprendre la valeur actuelle ($settings['hash_salt'] du settings.php du
# site) pour garder les sessions et liens déjà envoyés ; sinon :
#   openssl rand -base64 48
HASH_SALT=
# Secondes entre deux passages des tâches planifiées (cron).
CRON_INTERVALLE=3600
# 1 = afficher les erreurs PHP à l'écran (dépannage seulement).
AFFICHER_ERREURS=0

# --- Secrets des fonctions du site -------------------------------------------
# Mot de passe de la boîte site@kinshasa.cd (envoi des courriels).
SMTP_PASSWORD=
# Clé d'API de l'assistant virtuel (vide = assistant masqué).
ANTHROPIC_API_KEY=
