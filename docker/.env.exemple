# Réglages du site (services « web » et « db »). Copier ce fichier en
# « .env » (même dossier : docker/.env) et le remplir.
# Le fichier .env contient des secrets : chmod 600, JAMAIS dans Git, jamais
# envoyé par message.

# --- Noms de domaine ----------------------------------------------------------
# Noms acceptés par Drupal, séparés par des virgules ; tout autre nom reçoit
# une erreur 400. Pendant les essais : staging.kinshasa.cd. Après la bascule :
# kinshasa.cd,www.kinshasa.cd
DOMAINES=staging.kinshasa.cd
# 1 = demander aux moteurs de recherche de ne pas indexer (site de test).
# 0 = site public.
NOINDEX=1

# --- Base de données (service « db ») -------------------------------------------
# Nom du service de base sur le réseau privé du projet : ne pas changer.
DB_HOST=db
DB_PORT=3306
DB_NAME=drupal
DB_USER=drupal
# OBLIGATOIRE. Mot de passe long et aléatoire : openssl rand -base64 24
# Fixé à la création de la base : le changer ensuite demande aussi de le
# changer dans MariaDB (voir LISEZMOI).
DB_PASSWORD=
# Préfixe des tables : « cu68_ » pour la base reprise de l'hébergement actuel.
DB_PREFIX=cu68_

# --- Drupal ------------------------------------------------------------------------
# OBLIGATOIRE. Reprendre la valeur actuelle ($settings['hash_salt'] du
# settings.php du site actuel) pour garder sessions et liens déjà envoyés.
HASH_SALT=
# Secondes entre deux passages des tâches planifiées (drush cron).
CRON_INTERVALLE=3600
# 1 = afficher les erreurs PHP à l'écran (dépannage seulement).
AFFICHER_ERREURS=0

# --- Secrets des fonctions du site ------------------------------------------------
# Mot de passe de la boîte site@kinshasa.cd (envoi des courriels par
# mail.kinshasa.cd, port 465, SSL).
SMTP_PASSWORD=
# Clé d'API de l'assistant virtuel (Anthropic). Vide = assistant masqué.
ANTHROPIC_API_KEY=
# Adresse d'Ollama sur le réseau Docker « ia » (sans clé, sans passer par le
# proxy). Mise à disposition du chatbot ; non utilisée par l'assistant actuel.
OLLAMA_BASE_URL=http://ollama:11434
