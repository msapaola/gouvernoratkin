# Caddy : porte d'entrée du conteneur.
#
# SITE_ADDRESS (fichier .env) décide du fonctionnement :
#   - « :80 » (par défaut) : HTTP seul, pour un essai ou derrière un autre
#     proxy qui gère déjà le HTTPS ;
#   - « kinshasa.cd, www.kinshasa.cd » : HTTPS automatique (Let's Encrypt).
#     Les domaines doivent déjà pointer vers le serveur, ports 80 et 443
#     ouverts.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip
	# Ne pas annoncer les logiciels et versions utilisés.
	header -Server
	reverse_proxy 127.0.0.1:8080 {
		header_down -Server
	}
}
