<?php

/**
 * @file
 * Textes de la page d'accueil modifiables par la rédaction.
 *
 * Les textes de l'accueil étaient écrits en dur dans page--front.html.twig :
 * seule une personne modifiant le code pouvait les mettre à jour, et ils
 * n'existaient pas dans la base (donc invisibles pour tout outil qui lit les
 * contenus de Drupal, comme l'assistant). Ils vivent désormais dans des blocs
 * de contenu, que la rédaction modifie dans Contenu › Blocs :
 * - « Textes du site » (type page_accueil) : une section par partie de page
 *   (bandeau, accès rapide, À propos… de l'accueil ; en-têtes des pages
 *   Actualités, Contact…, encadrés, pied de page). Deux blocs de ce type
 *   existent : « Page d'accueil » et « Textes des autres pages » ;
 * - « Mot du gouverneur » (type mot_gouverneur) ;
 * - « Chiffres clés » (type chiffres_cles).
 *
 * Ce module lit le plus récent bloc publié de chaque type et le donne au
 * gabarit sous forme de variables simples ; la mise en page reste dans le
 * thème. Les textes de départ sont recopiés par gouvernorat_accueil.deploy.php.
 */

use Drupal\block_content\BlockContentInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Renvoie le plus récent bloc publié d'un type donné.
 */
function gouvernorat_accueil_bloc(string $type): ?BlockContentInterface {
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', $type)
    ->condition('status', 1)
    ->sort('changed', 'DESC')
    ->range(0, 1)
    ->execute();
  return $ids ? $storage->load(reset($ids)) : NULL;
}

/**
 * Découpe un texte saisi en paragraphes, sur les lignes vides.
 */
function gouvernorat_accueil_paragraphes(?string $texte): array {
  $paragraphes = preg_split('/\R\s*\R/u', trim((string) $texte));
  return array_values(array_filter(array_map('trim', $paragraphes), 'strlen'));
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 *
 * Variables fournies à tous les gabarits de page :
 * - textes : les sections des blocs « Textes du site », par partie de page.
 * Variables fournies à page--front.html.twig :
 * - accueil : les sections du bloc « Page d'accueil », par partie de la page
 *   (accueil.bandeau, accueil.acces…), voir gouvernorat_accueil_sections() ;
 * - gouverneur : nom, fonction, paragraphes (liste), portrait (url, alt) ;
 * - chiffres : items (liste de { valeur, libelle }), source.
 * Une variable reste vide si aucun bloc n'est publié : la section n'est alors
 * pas affichée.
 */
function gouvernorat_accueil_preprocess_page(array &$variables) {
  // Toute modification d'un bloc de contenu doit rafraîchir les pages, y
  // compris dans le cache des pages servies aux visiteurs anonymes.
  $variables['#cache']['tags'][] = 'block_content_list';

  // Textes des pages (en-têtes, encadrés, pied de page) : variable textes,
  // une entrée par partie de page (textes.entete_contact…).
  $variables['textes'] = gouvernorat_accueil_sections();

  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  $variables['accueil'] = $variables['textes'];

  if ($bloc = gouvernorat_accueil_bloc('mot_gouverneur')) {
    $portrait = NULL;
    $image = $bloc->get('field_gouverneur_portrait')->first();
    if ($image && $image->entity) {
      $style = ImageStyle::load('portrait_gouverneur');
      $uri = $image->entity->getFileUri();
      $portrait = [
        'url' => $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri),
        'alt' => $image->alt,
      ];
    }
    $variables['gouverneur'] = [
      'nom' => $bloc->get('field_gouverneur_nom')->value,
      'fonction' => $bloc->get('field_gouverneur_fonction')->value,
      'paragraphes' => gouvernorat_accueil_paragraphes($bloc->get('field_gouverneur_citation')->value),
      'portrait' => $portrait,
    ];
  }

  if ($bloc = gouvernorat_accueil_bloc('chiffres_cles')) {
    $items = [];
    foreach ($bloc->get('field_chiffres')->referencedEntities() as $chiffre) {
      $items[] = [
        'valeur' => $chiffre->get('field_chiffre_valeur')->value,
        'libelle' => $chiffre->get('field_chiffre_libelle')->value,
      ];
    }
    $variables['chiffres'] = [
      'items' => $items,
      'source' => $bloc->get('field_chiffres_source')->value,
    ];
  }
}

/**
 * Sections des blocs « Textes du site », indexées par partie de page.
 *
 * Chaque section : surtitre, titre, corps (texte mis en forme), liens
 * (titre, url, externe), image (url, alt), legende et elements (cartes :
 * icone, titre, texte, corps, lien, couleur). Une partie sans section
 * publiée est absente : le gabarit n'affiche alors pas ses textes.
 */
function gouvernorat_accueil_sections(): array {
  $sections = &drupal_static(__FUNCTION__);
  if (isset($sections)) {
    return $sections;
  }
  $sections = [];
  $storage = \Drupal::entityTypeManager()->getStorage('block_content');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page_accueil')
    ->condition('status', 1)
    ->sort('id')
    ->execute();
  $parties = [];
  foreach ($storage->loadMultiple($ids) as $bloc) {
    if ($bloc->hasField('field_accueil_sections')) {
      array_push($parties, ...$bloc->get('field_accueil_sections')->referencedEntities());
    }
  }
  foreach ($parties as $section) {
    $cle = $section->get('field_sec_cle')->value;
    if (!$cle || isset($sections[$cle]) || !$section->isPublished()) {
      continue;
    }
    $image = NULL;
    $element = $section->get('field_sec_image')->first();
    if ($element && $element->entity) {
      $image = [
        'url' => \Drupal::service('file_url_generator')->generateString($element->entity->getFileUri()),
        'alt' => $element->alt,
      ];
    }
    $cartes = [];
    foreach ($section->get('field_sec_elements')->referencedEntities() as $carte) {
      if ($carte->isPublished()) {
        $cartes[] = [
          'icone' => $carte->get('field_sec_icone')->value,
          'titre' => $carte->get('field_sec_titre')->value,
          'texte' => gouvernorat_accueil_texte_brut($carte, 'field_sec_corps'),
          'corps' => gouvernorat_accueil_texte($carte, 'field_sec_corps'),
          'lien' => gouvernorat_accueil_liens($carte)[0] ?? NULL,
          'couleur' => $carte->hasField('field_sec_couleur') ? $carte->get('field_sec_couleur')->value : NULL,
        ];
      }
    }
    $sections[$cle] = [
      'surtitre' => $section->get('field_sec_surtitre')->value,
      'titre' => $section->get('field_sec_titre')->value,
      'corps' => gouvernorat_accueil_texte($section, 'field_sec_corps'),
      'liens' => gouvernorat_accueil_liens($section),
      'image' => $image,
      'legende' => $section->get('field_sec_legende')->value,
      'elements' => $cartes,
    ];
  }
  return $sections;
}

/**
 * Texte mis en forme d'un champ, prêt à afficher (ou NULL s'il est vide).
 */
function gouvernorat_accueil_texte(ParagraphInterface $paragraphe, string $champ): ?array {
  if (!$paragraphe->hasField($champ) || $paragraphe->get($champ)->isEmpty()) {
    return NULL;
  }
  $valeur = $paragraphe->get($champ)->first();
  return ['#type' => 'processed_text', '#text' => $valeur->value, '#format' => $valeur->format];
}

/**
 * Même texte, sans mise en forme (pour les cartes).
 */
function gouvernorat_accueil_texte_brut(ParagraphInterface $paragraphe, string $champ): ?string {
  if (!$paragraphe->hasField($champ) || $paragraphe->get($champ)->isEmpty()) {
    return NULL;
  }
  $texte = html_entity_decode(strip_tags((string) $paragraphe->get($champ)->value), ENT_QUOTES | ENT_HTML5, 'UTF-8');
  return trim(preg_replace('/\s+/u', ' ', $texte));
}

/**
 * Liens d'un paragraphe : titre, adresse, et s'il mène hors du site.
 */
function gouvernorat_accueil_liens(ParagraphInterface $paragraphe): array {
  $liens = [];
  if (!$paragraphe->hasField('field_sec_liens')) {
    return $liens;
  }
  foreach ($paragraphe->get('field_sec_liens') as $lien) {
    $url = $lien->getUrl();
    $liens[] = [
      'titre' => $lien->title,
      'url' => $url->toString(),
      'externe' => $url->isExternal(),
    ];
  }
  return $liens;
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * La fiche d'une démarche affiche la colonne des services (encadré « Besoin
 * d'aide ? ») : elle reçoit aussi les textes du site.
 */
function gouvernorat_accueil_preprocess_node(array &$variables) {
  if ($variables['node']->bundle() === 'service_au_citoyen') {
    $variables['textes'] = gouvernorat_accueil_sections();
    $variables['#cache']['tags'][] = 'block_content_list';
  }
}
