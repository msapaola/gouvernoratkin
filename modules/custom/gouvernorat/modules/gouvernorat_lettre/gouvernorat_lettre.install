<?php

/**
 * @file
 * Tables des abonnés et des envois de la lettre d'information.
 */

/**
 * Implements hook_schema().
 */
function gouvernorat_lettre_schema(): array {
  $schema['gouvernorat_lettre_abonne'] = [
    'description' => "Abonnés à la lettre d'information.",
    'fields' => [
      'aid' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'courriel' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE],
      'statut' => [
        'description' => '0 : en attente de confirmation, 1 : inscrit.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'jeton' => ['type' => 'varchar_ascii', 'length' => 64, 'not null' => TRUE],
      'cree' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'confirme' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'origine' => [
        'description' => 'formulaire ou ajout (par la rédaction).',
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'formulaire',
      ],
    ],
    'primary key' => ['aid'],
    'unique keys' => [
      'courriel' => ['courriel'],
      'jeton' => ['jeton'],
    ],
    'indexes' => ['statut' => ['statut']],
  ];

  $schema['gouvernorat_lettre_edition'] = [
    'description' => 'Lettres envoyées : texte figé au moment du départ.',
    'fields' => [
      'eid' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'sujet' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'html' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'texte' => ['type' => 'text', 'size' => 'big', 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'cree' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['eid'],
    'indexes' => ['nid' => ['nid']],
  ];

  $schema['gouvernorat_lettre_envoi'] = [
    'description' => "File d'envoi : une ligne par lettre et par abonné.",
    'fields' => [
      'eid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'aid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'statut' => [
        'description' => '0 : à envoyer, 1 : envoyé, 2 : échec.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'essais' => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'envoye' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['eid', 'aid'],
    'indexes' => [
      'statut' => ['statut'],
      'nid_aid' => ['nid', 'aid'],
    ],
  ];

  return $schema;
}
