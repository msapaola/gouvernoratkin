{#
/**
 * @file
 * Courriel de la lettre d'information (et de confirmation d'inscription).
 *
 * Mise en page en tableaux et styles en ligne : c'est ce que les messageries
 * (Gmail, Outlook, téléphones) affichent de façon fiable.
 */
#}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ titre }}</title>
</head>
<body style="margin:0;padding:0;background:#eef2f8;font-family:Arial,Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef2f8;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background:#ffffff;border-radius:12px;overflow:hidden;">
        <tr>
          <td style="height:6px;background:#104293;font-size:0;line-height:0;">&nbsp;</td>
        </tr>
        <tr>
          <td align="center" style="padding:24px 24px 8px;">
            <a href="{{ accueil }}" style="text-decoration:none;">
              <img src="{{ logo }}" width="180" alt="Gouvernorat de la Ville-Province de Kinshasa" style="display:block;width:180px;max-width:60%;height:auto;border:0;">
            </a>
          </td>
        </tr>
        <tr>
          <td style="padding:8px 32px 0;">
            <h1 style="margin:16px 0 20px;font-size:24px;line-height:1.3;color:#104293;font-family:Arial,Helvetica,sans-serif;">{{ titre }}</h1>
            {{ corps }}
          </td>
        </tr>
        {% for article in articles %}
          <tr>
            <td style="padding:8px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e1e7f0;border-radius:10px;overflow:hidden;">
                {% if article.image %}
                  <tr>
                    <td>
                      <a href="{{ article.url }}"><img src="{{ article.image }}" width="536" alt="" style="display:block;width:100%;height:auto;border:0;"></a>
                    </td>
                  </tr>
                {% endif %}
                <tr>
                  <td style="padding:16px 18px;">
                    <p style="margin:0 0 6px;font-size:12px;color:#5b6472;text-transform:uppercase;letter-spacing:1px;">{{ article.date }}</p>
                    <p style="margin:0 0 8px;font-size:18px;line-height:1.35;font-weight:bold;"><a href="{{ article.url }}" style="color:#104293;text-decoration:none;">{{ article.titre }}</a></p>
                    {% if article.resume %}
                      <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#2f3540;">{{ article.resume }}</p>
                    {% endif %}
                    <a href="{{ article.url }}" style="font-size:14px;font-weight:bold;color:#104293;">Lire l'article &rarr;</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        {% endfor %}
        {% if bouton %}
          <tr>
            <td align="center" style="padding:20px 32px 8px;">
              <a href="{{ bouton.url }}" style="display:inline-block;padding:14px 28px;background:#104293;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;border-radius:8px;">{{ bouton.texte }}</a>
            </td>
          </tr>
        {% endif %}
        {% if apres %}
          <tr>
            <td style="padding:16px 32px 0;">{{ apres }}</td>
          </tr>
        {% endif %}
        <tr>
          <td style="padding:24px 32px 28px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="border-top:1px solid #e1e7f0;padding-top:18px;font-size:13px;line-height:1.6;color:#5b6472;text-align:center;">
                  Gouvernorat de la Ville-Province de Kinshasa<br>
                  <a href="{{ accueil }}" style="color:#104293;">{{ accueil|replace({'https://': '', 'http://': ''})|trim('/') }}</a>
                  {% if desabonnement %}
                    <br><br>Vous recevez ce courriel car vous êtes inscrit à la lettre d'information.<br>
                    <a href="{{ desabonnement }}" style="color:#5b6472;">Se désabonner</a>
                  {% endif %}
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
