# Ce qui n'entre JAMAIS dans l'image Docker (contexte de construction).

# Historique, outils.
.git
.github
.claude
**/.DS_Store
**/*.log

# Secrets, exports de base et sauvegardes du serveur.
docker/.env
docker/import/
docker/sauvegardes/
**/*.sql
**/*.sql.gz
**/*.tgz
**/*.tar.gz
**/*.zip

# Réglages locaux d'un site de test ou de développement.
sites/default/settings.php
sites/default/settings.local.php

# Fichiers téléversés : ils vivent dans le volume gouvernorat_fichiers…
sites/default/files/*
# … sauf la configuration exportée, que l'image range hors du site
# (/var/www/config/sync).
!sites/default/files/config_*
